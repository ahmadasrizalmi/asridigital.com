<script>
  // Play Store Card Slider Controller
  const track = document.getElementById('apps-slider-track');
  const prevBtn = document.getElementById('apps-slider-prev');
  const nextBtn = document.getElementById('apps-slider-next');
  const dots = document.querySelectorAll('.apps-dot');
  let currentIndex = 0;
  const totalSlides = 3;

  function updateSlider(index: number) {
    currentIndex = (index + totalSlides) % totalSlides;
    if (track) {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    }
    dots.forEach((d, i) => {
      if (i === currentIndex) {
        d.classList.add('bg-emerald-500', 'w-6');
        d.classList.remove('bg-slate-200', 'w-3');
      } else {
        d.classList.remove('bg-emerald-500', 'w-6');
        d.classList.add('bg-slate-200', 'w-3');
      }
    });
  }

  prevBtn?.addEventListener('click', () => updateSlider(currentIndex - 1));
  nextBtn?.addEventListener('click', () => updateSlider(currentIndex + 1));
  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const idx = parseInt((e.currentTarget as HTMLElement).dataset.index || '0', 10);
      updateSlider(idx);
    });
  });

  // Touch Swipe for Mobile-First
  let startX = 0;
  let endX = 0;
  track?.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
  }, { passive: true });
  track?.addEventListener('touchend', (e) => {
    endX = e.changedTouches[0].clientX;
    const diff = startX - endX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) updateSlider(currentIndex + 1);
      else updateSlider(currentIndex - 1);
    }
  }, { passive: true });
</script>
