---
// PlayStoreAppsSlider.astro — Interactive Play Store Style Showcase Card Slider
---

<div class="relative w-full" id="apps-slider-root">
  <!-- Slides Container -->
  <div class="overflow-hidden">
    <div class="flex transition-transform duration-500 ease-out" id="apps-slider-track">

      <!-- ==================== SLIDE 1: CYCLEJOURNAL (FLAGSHIP APP) ==================== -->
      <div class="w-full flex-shrink-0 px-1 sm:px-2">
        <div class="bg-white rounded-3xl border border-slate-200 shadow-card p-6 sm:p-8 lg:p-10 relative overflow-hidden">
          <!-- Top Flagship Ribbon -->
          <div class="absolute -top-1 right-8 px-4 py-1 rounded-b-xl bg-gradient-to-r from-[#FF8A71] to-[#FF5E7D] text-white font-extrabold text-[10px] uppercase tracking-wider shadow-sm">
            Produk Unggulan &bull; Flagship App
          </div>

          <!-- Section 1: App Identity Header (Play Store Style) -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 pb-6 border-b border-slate-100">
            <div class="flex items-center sm:items-start gap-4 sm:gap-5">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-[#FF8A71] to-[#FF5E7D] flex-shrink-0 flex items-center justify-center p-2 shadow-md border border-coral-500/20">
                <img src="/images/apps/cyclejournal/icon.png" alt="Logo CycleJournal" class="w-12 h-12 sm:w-16 sm:h-16 object-contain" />
              </div>

              <div>
                <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-rose-700 bg-rose-50 px-2.5 py-0.5 rounded-full border border-rose-200 mb-1.5">
                  Kesehatan &bull; Medis Klinis
                </span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
                  CycleJournal
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
                  Kalender Haid, Kesuburan &amp; Laporan Dokter SpOG &bull; Asri Digital Studio
                </p>

                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 mt-3 text-xs text-slate-600">
                  <span class="inline-flex items-center gap-1 font-semibold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-md border border-rose-200/60">
                    Versi 1.1.0
                  </span>
                  <span class="inline-flex items-center gap-1 font-semibold text-teal-700 bg-teal-50 px-2.5 py-1 rounded-md border border-teal-200/60">
                    Standar Klinis FIGO
                  </span>
                  <span class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200/60">
                    100% Offline &amp; Zero-Knowledge
                  </span>
                </div>
              </div>
            </div>

            <!-- Category & Badge -->
            <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2 mt-4 sm:mt-0">
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                Official Google Play
              </span>
              <span class="text-[11px] text-slate-400">Target Usia 12+</span>
            </div>
          </div>

          <!-- Section 2: Horizontal Screenshot Rail (Aset Resmi Goldie 1080x1920) -->
          <div class="py-6 border-b border-slate-100">
            <div class="flex items-center justify-between mb-3 text-xs text-slate-500 font-medium">
              <span>Tangkapan Layar Resmi Aplikasi (Desain Play Store):</span>
              <span class="hidden sm:inline text-slate-400">5 Screenshot Berbingkai &bull; Resolusi Tinggi</span>
            </div>

            <div class="flex gap-4 sm:gap-5 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scrollbar-thin">
              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/cyclejournal/01-dashboard.png" alt="01. Pelacak Siklus Berstandar Medis" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">1. Dasbor Siklus</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/cyclejournal/02-daily-log.png" alt="02. Jurnal Gejala & Skala Nyeri" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">2. Jurnal Gejala</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/cyclejournal/03-medical-report.png" alt="03. Laporan Medis Siap SpOG" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">3. Laporan PDF SpOG</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/cyclejournal/04-privacy-security.png" alt="04. Privasi Mutlak Zero-Knowledge" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">4. Privasi Kunci PIN</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/cyclejournal/05-data-portability.png" alt="05. Kedaulatan Penuh Atas Data" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">5. Cadangan &amp; Reset</p>
              </div>
            </div>
          </div>

          <!-- Section 3: About App (Ringkasan Nilai Manfaat) -->
          <div class="py-5 border-b border-slate-100">
            <h4 class="text-sm font-bold text-slate-900 mb-2">Tentang CycleJournal</h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Instrumen pencatatan siklus menstruasi dan kesuburan berstandar medis klinis yang dirancang 100% offline-first. Membantu Anda mengenali kesehatan reproduksi mandiri, mendeteksi 7 tanda bahaya FIGO, dan menghasilkan dokumen rekapitulasi medis A4 1-halaman yang siap dibawa saat konsultasi ke dokter kandungan (SpOG).
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs text-slate-600 font-medium">
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-rose-50 border border-rose-100 text-rose-900">
                <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg>
                <span>Laporan PDF Siap SpOG</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-teal-50 border border-teal-100 text-teal-900">
                <svg class="w-4 h-4 text-teal-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>Skrining 7 Anomali FIGO</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-900">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                <span>100% Offline SQLCipher</span>
              </div>
            </div>
          </div>

          <!-- Section 4: Action Buttons (Play Store Badge & Detail Only) -->
          <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 w-full sm:w-auto">
              <a href="https://play.google.com/store/apps/details?id=com.app.cyclejournal" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl bg-slate-900 text-white font-extrabold text-xs shadow-lg hover:bg-slate-800 transition transform hover:-translate-y-0.5 w-full sm:w-auto justify-center">
                <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none">
                  <path d="M3.609 1.814L13.792 12 3.61 22.186c-.234-.23-.37-.549-.37-.899V2.713c0-.35.136-.669.37-.899z" fill="#00E676"/>
                  <path d="M17.18 8.613L4.852 1.501c-.382-.22-.843-.205-1.243.037L13.792 12l3.388-3.387z" fill="#FFD54F"/>
                  <path d="M13.792 12l-10.183 10.462c.4.242.861.257 1.243.037l12.328-7.112L13.792 12z" fill="#FF3D00"/>
                  <path d="M20.573 10.57l-3.393-1.957L13.792 12l3.388 3.387 3.393-1.958c.758-.438 1.227-1.242 1.227-2.116s-.469-1.678-1.227-2.116z" fill="#40C4FF"/>
                </svg>
                <div class="text-left">
                  <div class="text-[9px] uppercase tracking-wider text-slate-400 font-bold leading-none">TEMUKAN DI</div>
                  <div class="text-xs font-black leading-tight text-white">Google Play</div>
                </div>
              </a>
            </div>

            <a href="/apps/cyclejournal" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl border border-rose-300 bg-rose-50/60 font-bold text-xs text-rose-800 hover:bg-rose-100 hover:border-rose-400 transition w-full sm:w-auto">
              <span>Pelajari Detail Aplikasi CycleJournal</span>
              <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>

        </div>
      </div>


      <!-- ==================== SLIDE 1: JAPANESE PDF TO WORD ==================== -->
      <div class="w-full flex-shrink-0 px-1 sm:px-2">
        <div class="bg-white rounded-3xl border border-slate-200 shadow-card p-6 sm:p-8 lg:p-10">

          <!-- Section 1: App Identity Header (Play Store Style) -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 pb-6 border-b border-slate-100">
            <div class="flex items-center sm:items-start gap-4 sm:gap-5">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 flex-shrink-0 flex items-center justify-center p-3 shadow-md border border-blue-500/20">
                <svg class="w-10 h-10 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>

              <div>
                <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full border border-blue-100 mb-1.5">
                  Produktivitas &bull; Pendidikan
                </span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                  Japanese PDF to Word
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
                  Furigana Ruby Edition &bull; Asri Digital Studio
                </p>

                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 mt-3 text-xs text-slate-600">
                  <span class="inline-flex items-center gap-1 font-semibold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md border border-blue-200/60">
                    Versi 1.0.0
                  </span>
                  <span class="inline-flex items-center gap-1 font-semibold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md">
                    Android 14 Ready
                  </span>
                  <span class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200/60">
                    100% Offline Lokal
                  </span>
                </div>
              </div>
            </div>

            <!-- Category & Badge -->
            <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2">
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-700">
                Official Google Play
              </span>
              <span class="text-[11px] text-slate-400">Peringkat 3+</span>
            </div>
          </div>

          <!-- Section 2: Horizontal Screenshot Rail (Aset Resmi Goldie) -->
          <div class="py-6 border-b border-slate-100">
            <div class="flex items-center justify-between mb-3 text-xs text-slate-500 font-medium">
              <span>Tangkapan Layar Aplikasi (Geser Horizontal):</span>
              <span class="hidden sm:inline text-slate-400">5 Screenshot Mockup &bull; Resolusi 1080x1920</span>
            </div>

            <div class="flex gap-4 sm:gap-5 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scrollbar-thin">
              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/japanese-pdf-to-word/01-home.png" alt="01. Pilih PDF" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">1. Pilih Dokumen</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/japanese-pdf-to-word/02-options.png" alt="02. Opsi Pengaturan" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">2. Format Furigana</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/japanese-pdf-to-word/03-processing.png" alt="03. Proses Konversi" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">3. Proses 68%</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/japanese-pdf-to-word/04-success.png" alt="04. Selesai & Unduh" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">4. Hasil Unduh DOCX</p>
              </div>

              <div class="flex-shrink-0 w-36 sm:w-44 snap-center group">
                <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-1.5 shadow-sm group-hover:shadow-md transition">
                  <img src="/images/apps/japanese-pdf-to-word/05-docx.png" alt="05. Pratinjau Word Rapi" class="w-full rounded-xl aspect-[9/16] object-cover" loading="lazy" />
                </div>
                <p class="text-[11px] font-semibold text-slate-700 text-center mt-2">5. Pratinjau Word</p>
              </div>
            </div>
          </div>

          <!-- Section 3: About App (Ringkasan Nilai Manfaat) -->
          <div class="py-5 border-b border-slate-100">
            <h4 class="text-sm font-bold text-slate-900 mb-2">Tentang Aplikasi Ini</h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Bagi Anda yang sedang belajar atau mengajar bahasa Jepang: ubah materi soal JLPT dan modul dari PDF langsung menjadi dokumen Word (.docx) yang rapi, tanpa khawatir bacaan furigana di atas kanji berantakan.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs text-slate-600 font-medium">
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>Furigana Tepat di Atas Kanji</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>Kolom Kosakata Tetap Rapi</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>Diproses di HP, Data Privat</span>
              </div>
            </div>
          </div>

          <!-- Section 4: Action Buttons (Play Store Badge & Detail Only) -->
          <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 w-full sm:w-auto">
              <a href="https://play.google.com/store/apps/details?id=com.kandaapps.japanesepdftoword" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl bg-slate-900 text-white font-extrabold text-xs shadow-lg hover:bg-slate-800 transition transform hover:-translate-y-0.5 w-full sm:w-auto justify-center">
                <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none">
                  <path d="M3.609 1.814L13.792 12 3.61 22.186c-.234-.23-.37-.549-.37-.899V2.713c0-.35.136-.669.37-.899z" fill="#00E676"/>
                  <path d="M17.18 8.613L4.852 1.501c-.382-.22-.843-.205-1.243.037L13.792 12l3.388-3.387z" fill="#FFD54F"/>
                  <path d="M13.792 12l-10.183 10.462c.4.242.861.257 1.243.037l12.328-7.112L13.792 12z" fill="#FF3D00"/>
                  <path d="M20.573 10.57l-3.393-1.957L13.792 12l3.388 3.387 3.393-1.958c.758-.438 1.227-1.242 1.227-2.116s-.469-1.678-1.227-2.116z" fill="#40C4FF"/>
                </svg>
                <div class="text-left">
                  <div class="text-[9px] uppercase tracking-wider text-slate-400 font-bold leading-none">TEMUKAN DI</div>
                  <div class="text-xs font-black leading-tight text-white">Google Play</div>
                </div>
              </a>
            </div>

            <a href="/apps/japanese-pdf-to-word" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl border border-slate-300 font-bold text-xs text-slate-800 hover:bg-slate-50 hover:border-slate-400 transition w-full sm:w-auto">
              <span>Pelajari Detail Aplikasi</span>
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>

        </div>
      </div>

      <!-- ==================== SLIDE 2: MASJID DISPLAY ==================== -->
      <div class="w-full flex-shrink-0 px-1 sm:px-2">
        <div class="bg-white rounded-3xl border border-slate-200 shadow-card p-6 sm:p-8 lg:p-10">

          <!-- Section 1: App Identity Header (Play Store Style) -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 pb-6 border-b border-slate-100">
            <div class="flex items-center sm:items-start gap-4 sm:gap-5">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-800 flex-shrink-0 flex items-center justify-center p-3 shadow-md border border-emerald-500/20">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              </div>

              <div>
                <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100 mb-1.5">
                  Android TV &bull; Takmir Masjid
                </span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                  Masjid Display
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
                  Display Informasi TV &bull; Asri Digital Studio
                </p>

                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 mt-3 text-xs text-slate-600">
                  <span class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200/60">
                    Versi 0.7.4
                  </span>
                  <span class="inline-flex items-center gap-1 font-semibold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md">
                    Android TV &bull; STB
