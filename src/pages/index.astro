                Diskusikan langsung kebutuhan perangkat lunak Anda bersama tim Asri Digital. Dapatkan saran arsitektur dan estimasi biaya yang masuk akal tanpa komitmen awal.
              </p>
            </div>

            <div class="lg:col-span-5 flex flex-col sm:flex-row lg:flex-col gap-4 justify-center">
              <!-- WhatsApp Consultation CTA (food-app-onboarding style) -->
              <a
                href="https://wa.me/62812999551?text=Halo%20Asri%20Digital,%20saya%20ingin%20konsultasi%20pembuatan%20software"
                target="_blank"
                rel="noopener noreferrer"
                class="group relative inline-flex items-center justify-center h-16 pl-2.5 pr-8 bg-btn-gradient rounded-full shadow-btn-primary transition-all transform hover:-translate-y-0.5 overflow-hidden w-full"
              >
                <div class="w-12 h-12 bg-white rounded-full shadow-sm flex items-center justify-center mr-4 text-slate-800 flex-shrink-0 group-hover:scale-105 transition">
                  <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.585 1.961.947 3.024.947 3.178 0 5.766-2.587 5.767-5.766.001-3.187-2.575-5.77-5.759-5.771zm5.216 11.121l-.158.077c-.43.208-1.579.776-1.821.863-.243.088-.42.132-.598-.132s-.687-.864-.842-1.04c-.155-.177-.31-.199-.553-.11-.243.088-1.026.378-1.954-.449-.724-.645-1.213-1.442-1.355-1.685-.143-.243-.015-.374.095-.494.099-.108.221-.277.332-.416.11-.138.147-.235.221-.391.074-.155.037-.291-.018-.407-.056-.116-.508-1.226-.696-1.68-.183-.443-.369-.382-.508-.389-.131-.007-.282-.008-.432-.008s-.398.056-.607.284c-.208.228-.797.778-.797 1.897 0 1.119.814 2.2 1.036 2.496.222.296 1.603 2.449 3.886 3.435.543.235.967.375 1.297.48.545.174 1.042.149 1.434.091.437-.065 1.344-.549 1.533-1.08.19-.531.19-.986.134-1.08-.056-.095-.208-.152-.43-.263z"></path></svg>
