---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FOMOPopup from '../components/marketing/FOMOPopup.astro';
import HotReleaseSlider from '../components/marketing/HotReleaseSlider.astro';
import PlayStoreAppsSlider from '../components/marketing/PlayStoreAppsSlider.astro';

// Structured data for Software House & Tech Agency
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Asri Digital",
  "url": "https://asridigital.com",
  "description": "Software House & Digital Studio: Jasa Pembuatan Aplikasi Android, Web & Otomasi Bisnis.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://asridigital.com/blog?search={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout structuredData={structuredData}>
  <Header />

  <main class="flex-1 overflow-hidden">

    <!-- ==================== 1. HERO SECTION (SOFTWARE HOUSE & APP STUDIO) ==================== -->
    <!-- Background: Ethereal Subtle Gradient with Atmospheric Grid Pattern -->
    <section class="relative min-h-[90vh] flex items-center justify-center pt-24 pb-20 bg-slate-900 text-white overflow-hidden">
      <!-- Atmospheric Backdrop Blur & Grid -->
      <div aria-hidden class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(16,185,129,0.3),transparent_70%)]"></div>
      <div aria-hidden class="pointer-events-none absolute inset-0 opacity-[0.03] bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:24px_24px]"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10 py-12">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-950/60 px-4 py-1.5 text-xs font-semibold text-emerald-300 mb-6 backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Studio Software &amp; Produk Digital
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.12]">
          Bikin Aplikasi Android, Web, dan <span class="bg-gradient-to-r from-emerald-400 via-teal-200 to-amber-200 bg-clip-text text-transparent">Sistem Otomasi Tanpa Ribet</span>
        </h1>

        <p class="mt-6 max-w-2xl mx-auto text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          Dari aplikasi smartphone dan TV yang siap rilis di Google Play sampai sistem web kustom untuk operasional bisnis. Kami rancang tuntas dengan performa enteng, aman, dan langsung siap pakai.
        </p>

        <!-- CTA Buttons (Inspired by wireframe food-app-onboarding + SSOT btn-gradient) -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-5">
          <!-- Primary CTA Button with nested circular icon -->
          <a
            href="https://wa.me/62812999551?text=Halo%20Asri%20Digital,%20saya%20ingin%20konsultasi%20pembuatan%20software"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center h-15 sm:h-16 pl-2.5 pr-8 bg-btn-gradient rounded-full shadow-btn-primary transition-all transform hover:-translate-y-0.5 overflow-hidden w-full sm:w-auto"
          >
            <div class="w-11 h-11 sm:w-12 sm:h-12 bg-white rounded-full shadow-sm flex items-center justify-center mr-4 text-slate-800 flex-shrink-0 group-hover:scale-105 transition">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </div>
            <span class="text-slate-900 font-extrabold text-sm sm:text-base tracking-wide whitespace-nowrap">Konsultasikan Kebutuhan Proyek</span>
          </a>

          <!-- Secondary CTA Button: Link to Apps Showcase -->
          <a
            href="#apps"
            class="inline-flex items-center justify-center h-15 sm:h-16 px-8 rounded-full border border-slate-700 bg-slate-800/60 text-slate-200 font-bold text-sm sm:text-base hover:bg-slate-800 hover:text-white backdrop-blur transition w-full sm:w-auto"
          >
            <span>Lihat Aplikasi Buatan Kami</span>
            <svg class="w-4 h-4 ml-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
        </div>

        <!-- Technical Trust Bar (Replacing pre-launch social proof) -->
        <div class="mt-14 pt-8 border-t border-slate-800/80 max-w-4xl mx-auto">
          <div class="flex flex-wrap justify-center items-center gap-5 sm:gap-10 text-center text-xs font-semibold text-slate-300">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              <span>Bisa Jalan Tanpa Internet</span>
            </div>
            <div class="hidden sm:block w-px h-4 bg-slate-800"></div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>Standar Resmi Google Play</span>
            </div>
            <div class="hidden sm:block w-px h-4 bg-slate-800"></div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              <span>Performa Enteng &amp; Kencang</span>
            </div>
            <div class="hidden sm:block w-px h-4 bg-slate-800"></div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
              <span>Bebas Biaya Server Bulanan</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 2. ABOUT & KEUNGGULAN SECTION ==================== -->
    <!-- Background: Pure White with Corner Geometric Ornaments -->
    <section id="about" class="relative py-24 bg-white border-b border-slate-100 overflow-hidden">
      <!-- Corner Geometric Accents (SVG Vector Ornaments) -->
      <div aria-hidden class="pointer-events-none absolute top-0 left-0 w-32 h-32 opacity-10">
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" class="w-full h-full text-slate-900"><path d="M0 0 L100 0 L0 100 Z" fill="currentColor"/><circle cx="30" cy="30" r="10" stroke="currentColor" stroke-width="2"/></svg>
      </div>
      <div aria-hidden class="pointer-events-none absolute bottom-0 right-0 w-40 h-40 opacity-10">
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" class="w-full h-full text-emerald-600"><circle cx="70" cy="70" r="25" stroke="currentColor" stroke-width="3"/><path d="M100 50 L100 100 L50 100" stroke="currentColor" stroke-width="4"/></svg>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Prinsip Kerja Kami</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
            Kenapa Mempercayakan Proyek Anda pada Asri Digital?
          </h2>
          <p class="text-slate-500 text-base mt-4 leading-relaxed">
            Kami tidak sekadar menulis baris kode, tapi memastikan teknologi yang dibangun benar-benar menyelesaikan masalah, mudah digunakan tim Anda, dan hemat biaya operasional.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Pillar 1 -->
          <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 shadow-soft hover:shadow-card-hover transition-all">
            <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            </div>
            <h3 class="font-extrabold text-slate-900 text-lg mb-2">Bisa Jalan Tanpa Internet</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Aplikasi dirancang agar tetap bisa bekerja lancar meski sinyal mati atau tanpa kuota. Bebas biaya sewa server bulanan yang menguras kas.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 shadow-soft hover:shadow-card-hover transition-all">
            <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="font-extrabold text-slate-900 text-lg mb-2">Enteng, Cepat &amp; Hemat Baterai</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Menggunakan arsitektur native yang efisien. Aplikasi tidak lemot saat dibuka, hemat penggunaan memori, dan nyaman dipakai berjam-jam.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 shadow-soft hover:shadow-card-hover transition-all">
            <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="font-extrabold text-slate-900 text-lg mb-2">Tampilan Rapi &amp; Gampang Dipakai</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Tata letak tombol dan navigasi diperhitungkan agar nyaman di jempol smartphone. Alurnya jelas dan tidak bikin pengguna bingung.
            </p>
          </div>

          <!-- Pillar 4 -->
          <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 shadow-soft hover:shadow-card-hover transition-all">
            <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h3 class="font-extrabold text-slate-900 text-lg mb-2">Data Aman &amp; Privasi Terjaga</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Kepatuhan penuh terhadap standar privasi Google Play. Data bisnis maupun dokumen pengguna tetap terlindungi tanpa risiko kebocoran ke luar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 3. APPS SHOWCASE SECTION (PLAY STORE SLIDER) ==================== -->
    <!-- Background: Soft Slate Gradient -->
    <section id="apps" class="py-24 bg-gradient-to-b from-slate-50 via-slate-100/60 to-slate-50 border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Karya Mandiri Kami</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
            Aplikasi Resmi di Google Play Store
          </h2>
          <p class="text-slate-500 text-base mt-4 leading-relaxed">
            Bukan sekadar contoh portofolio tugas. Kami membangun, merilis, dan merawat aplikasi nyata yang rutin digunakan oleh pengurus masjid dan pembelajar bahasa.
          </p>
        </div>

        <!-- The Interactive Play Store Style Card Slider Component -->
        <PlayStoreAppsSlider />

        <!-- Bottom Link to All Apps -->
        <div class="text-center mt-12">
          <a href="/apps" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-700 hover:text-emerald-800 transition underline underline-offset-4">
            <span>Lihat Semua Katalog Aplikasi Android Asri Digital</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== 4. LAYANAN JASA SOFTWARE HOUSE ==================== -->
    <!-- Background: Pure White with Subtle Corner Accents -->
    <section id="services" class="relative py-24 bg-white border-b border-slate-100 overflow-hidden">
      <!-- Corner Accents -->
      <div aria-hidden class="pointer-events-none absolute top-0 right-0 w-32 h-32 opacity-5">
        <svg viewBox="0 0 100 100" fill="currentColor" class="w-full h-full text-slate-900"><polygon points="100,0 0,0 100,100"/></svg>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Layanan Kami</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
            Solusi Pembuatan Software Sesuai Kebutuhan Anda
          </h2>
          <p class="text-slate-500 text-base mt-4 leading-relaxed">
            Mulai dari perancangan alur kerja, desain antarmuka, pembuatan program, sampai aplikasi siap dipakai atau tayang di Google Play Store.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Service 1: Mobile App -->
          <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center mb-6">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" stroke-width="2"></rect><line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2"></line></svg>
              </div>
              <h3 class="text-xl font-extrabold text-slate-900 mb-3">Aplikasi Android &amp; TV Kustom</h3>
              <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mb-6">
                Butuh aplikasi kasir, sistem inventaris toko, display TV informasi masjid, atau aplikasi publik di Google Play? Kami bantu wujudkan dari konsep awal hingga siap unduh.
              </p>
              <ul class="space-y-2.5 text-xs text-slate-600 font-medium mb-8">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Bisa Berjalan Offline &amp; Sinkron via Wi-Fi</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Pendampingan Upload ke Google Play Store</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Bisa Disematkan Fitur Iklan atau Beli Putus</li>
              </ul>
            </div>
            <a href="https://wa.me/62812999551?text=Halo%20Asri%20Digital,%20saya%20ingin%20konsultasi%20jasa%20pembuatan%20aplikasi%20Android" target="_blank" rel="noopener noreferrer" class="w-full py-3 rounded-xl border border-slate-300 text-slate-800 font-bold text-xs text-center hover:bg-slate-50 transition">
              Konsultasikan Kebutuhan Ini
            </a>
          </div>

          <!-- Service 2: Web App & Dashboard -->
          <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center mb-6">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
              </div>
              <h3 class="text-xl font-extrabold text-slate-900 mb-3">Aplikasi Web &amp; Dashboard Bisnis</h3>
              <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mb-6">
                Pantau operasional usaha, kelola data penjualan, atau buka portal pelanggan lewat dashboard web modern yang cepat dan mudah diakses dari perangkat apa saja.
              </p>
              <ul class="space-y-2.5 text-xs text-slate-600 font-medium mb-8">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Tampilan Bersih &amp; Waktu Muat Cepat</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Terhubung ke Pembayaran Otomatis QRIS / Bank</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Sistem Andal Tanpa Perlu Perawatan Rumit</li>
              </ul>
            </div>
            <a href="https://wa.me/62812999551?text=Halo%20Asri%20Digital,%20saya%20ingin%20konsultasi%20jasa%20pembuatan%20aplikasi%20Web" target="_blank" rel="noopener noreferrer" class="w-full py-3 rounded-xl border border-slate-300 text-slate-800 font-bold text-xs text-center hover:bg-slate-50 transition">
              Konsultasikan Kebutuhan Ini
            </a>
          </div>

          <!-- Service 3: AI & Automation -->
          <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-800 flex items-center justify-center mb-6">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <h3 class="text-xl font-extrabold text-slate-900 mb-3">Otomasi Pekerjaan &amp; Solusi AI</h3>
              <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mb-6">
                Pangkas tugas berulang yang memakan waktu tim Anda. Mulai dari bot WhatsApp otomatis untuk layanan pelanggan, perapian data dokumen, hingga integrasi kecerdasan buatan.
              </p>
              <ul class="space-y-2.5 text-xs text-slate-600 font-medium mb-8">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Balas Pesan Pelanggan Otomatis 24 Jam</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Ekstraksi &amp; Olah Data Dokumen Otomatis</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Solusi AI Praktis Sesuai Kebutuhan Nyata</li>
              </ul>
            </div>
            <a href="https://wa.me/62812999551?text=Halo%20Asri%20Digital,%20saya%20ingin%20konsultasi%20jasa%20otomasi%20dan%20AI" target="_blank" rel="noopener noreferrer" class="w-full py-3 rounded-xl border border-slate-300 text-slate-800 font-bold text-xs text-center hover:bg-slate-50 transition">
              Konsultasikan Kebutuhan Ini
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 5. HOT RELEASE & PRODUK DIGITAL TERLARIS ==================== -->
    <!-- Background: Soft Slate Gradient -->
    <HotReleaseSlider />

    <section id="produk" class="py-24 bg-slate-50 border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
