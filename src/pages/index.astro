</BaseLayout>

<script>
  // ===== DYNAMIC DATA FROM D1 VIA API =====

  function optimizeImg(url: string, w?: number, h?: number) {
    if (!url) return '/images/placeholder.jpg';
    if (!url.startsWith('http')) return url;
    if (url.includes('res.cloudinary.com') && !url.includes('/upload/w_')) {
      return url.replace('/upload/', `/upload/w_${w || 400},h_${h || 225},c_fill,f_auto,q_auto/`);
    }
    return url;
  }

  async function loadDynamicContent() {
    try {
      const [settingsRes, categoriesRes] = await Promise.all([
        fetch('/api/site-settings?keys=catalog_section_title,catalog_section_description'),
        fetch('/api/categories')
      ]);

      const settings = await settingsRes.json();
      const catData = await categoriesRes.json();

      // Catalog section title
      if (settings.catalog_section_title && document.getElementById('catalog-title')) {
        document.getElementById('catalog-title')!.textContent = settings.catalog_section_title;
      }
      if (settings.catalog_section_description && document.getElementById('catalog-desc')) {
        document.getElementById('catalog-desc')!.textContent = settings.catalog_section_description;
      }

      // Filter tabs from categories
      const tabsContainer = document.getElementById('filter-tabs');
      if (tabsContainer) {
        const categories = catData.categories || [];
        if (categories.length > 0) {
          const catTabsHtml = categories.map((c: any) =>
            `<button class="filter-tab px-5 py-2 rounded-full text-sm font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 transition-colors whitespace-nowrap" data-filter="${c.slug}">${c.name}</button>`
          ).join('');
          tabsContainer.innerHTML = `<button class="filter-tab active px-5 py-2 rounded-full text-sm font-semibold text-white bg-slate-900 transition-colors whitespace-nowrap" data-filter="all">Semua</button>` + catTabsHtml;
          initFilterTabs();
        }
      }

      // Load products
      await loadProducts();
    } catch (e) {
      console.error('Error loading dynamic content:', e);
    }
  }

  let allProducts: any[] = [];
  let currentFilter = 'all';

  async function loadProducts() {
    try {
      const res = await fetch('/api/products?is_active=true');
      const data = await res.json();
      allProducts = (data.products || []).filter((p: any) => p.slug !== 'lifetime-all-access-pass');
      renderProducts();
    } catch (e) {
      console.error('Error loading products:', e);
    }
  }

  function renderProducts() {
    const grid = document.getElementById('product-grid');
    const noResults = document.getElementById('no-results');
    if (!grid) return;

    const searchTerm = ((document.getElementById('product-search') as HTMLInputElement)?.value || '').toLowerCase();

    const filtered = allProducts.filter((p: any) => {
      const matchesFilter = currentFilter === 'all' || p.category_slug === currentFilter || p.category === currentFilter;
      const matchesSearch = !searchTerm || p.title.toLowerCase().includes(searchTerm) || (p.description && p.description.toLowerCase().includes(searchTerm));
      return matchesFilter && matchesSearch;
    });

    if (filtered.length === 0) {
      grid.innerHTML = '';
      if (noResults) noResults.classList.remove('hidden');
      return;
    }

    if (noResults) noResults.classList.add('hidden');

    grid.innerHTML = filtered.slice(0, 6).map((p: any) => {
      const discount = p.original_price && p.original_price > p.price
        ? Math.round(((p.original_price - p.price) / p.original_price) * 100)
        : 0;

      const rawImg = p.image_icon || p.imageIcon || p.image_url || '';

      return `
        <div class="product-card bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-soft hover:shadow-card-hover transition-all flex flex-col justify-between">
          <div>
            <div class="relative aspect-video bg-slate-100 overflow-hidden">
              <img src="${optimizeImg(rawImg, 400, 225)}" alt="${p.title}" class="w-full h-full object-cover" loading="lazy" />
              ${discount > 0 ? `<span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">Hemat ${discount}%</span>` : ''}
              ${p.is_hot ? `<span class="absolute top-3 right-3 bg-amber-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">Hot</span>` : ''}
            </div>
            <div class="p-6">
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 mb-1 block">${p.category_name || p.category || 'Digital Tool'}</span>
              <h3 class="font-extrabold text-slate-900 text-base mb-2 line-clamp-2 leading-snug">${p.title}</h3>
              <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed">${p.description || ''}</p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-base font-extrabold text-slate-900">Rp ${Number(p.price).toLocaleString('id-ID')}</span>
              ${p.original_price ? `<span class="text-xs text-slate-400 line-through ml-1.5">Rp ${Number(p.original_price).toLocaleString('id-ID')}</span>` : ''}
            </div>
            <a href="/product/${p.slug}" class="px-4 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition">
              Lihat Detail
            </a>
          </div>
        </div>
      `;
    }).join('');
  }

  function initFilterTabs() {
    const tabs = document.querySelectorAll('.filter-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        tabs.forEach(t => {
          t.classList.remove('bg-slate-900', 'text-white');
          t.classList.add('bg-white', 'text-slate-600');
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.remove('bg-white', 'text-slate-600');
        target.classList.add('bg-slate-900', 'text-white');
        currentFilter = target.dataset.filter || 'all';
        renderProducts();
      });
    });
  }

  document.getElementById('product-search')?.addEventListener('input', () => {
    renderProducts();
  });

  // Load when DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadDynamicContent);
  } else {
    loadDynamicContent();
  }
</script>
