<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.theme-btn');
    const image = document.getElementById('featured-image') as HTMLImageElement;
    const title = document.getElementById('featured-title');
    const desc = document.getElementById('featured-desc');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetImg = btn.getAttribute('data-img');
        const targetTitle = btn.getAttribute('data-title');
        const targetDesc = btn.getAttribute('data-desc');

        if (image && targetImg) {
          image.style.opacity = '0';
          setTimeout(() => {
            image.src = targetImg;
            image.style.opacity = '1';
          }, 150);
        }
        if (title && targetTitle) title.textContent = targetTitle;
        if (desc && targetDesc) desc.textContent = targetDesc;

        buttons.forEach((b) => {
          b.classList.remove('bg-emerald-600', 'text-white');
          b.classList.add('bg-slate-800', 'text-slate-300');
        });
        btn.classList.remove('bg-slate-800', 'text-slate-300');
        btn.classList.add('bg-emerald-600', 'text-white');
      });
    });
  });
</script>

<style>
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
  @keyframes marquee {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
  }
</style>
