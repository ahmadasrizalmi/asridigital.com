---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Icon from '../components/ui/Icon.astro';

const title = "Masjid Display Asri Digital | TV Informasi 100% Offline";
const description = "Ubah TV Masjid Anda menjadi pusat informasi jadwal sholat dan pengumuman dengan Masjid Display. 100% Offline tanpa biaya bulanan.";
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="flex-grow pt-24 pb-16">
    <!-- Hero Section -->
    <section class="bg-emerald-800 text-white py-20 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 text-emerald-50">
          Transformasi TV Masjid Menjadi Pusat Informasi Digital yang Elegan & 100% Mandiri
        </h1>
        <p class="text-lg md:text-xl text-emerald-100 mb-8 max-w-3xl mx-auto">
          Tanpa internet, tanpa biaya langganan bulanan. Jadwal sholat akurat astronomis, slideshow foto pengumuman DKM, dan kontrol penuh dari HP via Wi-Fi lokal.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
          <a href="https://play.google.com/store/apps/details?id=com.asridigital.masjiddisplay.admin" target="_blank" rel="noopener" class="bg-amber-500 hover:bg-amber-600 text-white font-bold py-4 px-8 rounded-full shadow-lg transition-transform transform hover:scale-105">
            Beli Admin di Google Play — Rp 249.000
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.asridigital.masjiddisplay.tv" target="_blank" rel="noopener" class="bg-emerald-700 hover:bg-emerald-600 border border-emerald-500 text-white font-bold py-4 px-8 rounded-full shadow-lg transition-transform transform hover:scale-105">
            Download TV App — Gratis
          </a>
        </div>
        <div class="flex flex-wrap justify-center gap-4 text-emerald-200 text-sm md:text-base font-medium">
          <span class="flex items-center gap-2"><Icon name="check-circle" size={16} class="text-emerald-400" /> 100% Offline</span>
          <span class="flex items-center gap-2"><Icon name="check-circle" size={16} class="text-emerald-400" /> Beli Sekali Aktif Selamanya</span>
          <span class="flex items-center gap-2"><Icon name="check-circle" size={16} class="text-emerald-400" /> Kompatibel Semua Android TV & STB</span>
        </div>
      </div>
    </section>

    <!-- 9 Themes Showcase Section with Real Screenshots -->
    <section class="py-20 bg-slate-950 text-white px-6 overflow-hidden">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="bg-emerald-900/80 text-emerald-300 text-xs md:text-sm font-bold uppercase tracking-wider px-4 py-1.5 rounded-full border border-emerald-700/60 inline-block mb-4">
            Pilihan Visual Eksklusif
          </span>
          <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
            9 Layout & Tema Desain Modern Siap Pakai
          </h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-base md:text-lg">
            Setiap masjid memiliki karakter arsitektur unik. Pilih tata letak dan tema warna favorit Anda hanya dengan 1 kali klik dari HP Admin.
          </p>
        </div>

        <!-- Featured Interactive Live Screen Viewer -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-8 mb-16 shadow-2xl">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800">
            <div>
              <h3 class="text-xl md:text-2xl font-bold text-white" id="featured-title">1. Prism Horizon</h3>
              <p class="text-slate-400 text-sm" id="featured-desc">Dock 6 kartu sholat warna-warni pastel di bawah dengan header kaca transparan.</p>
            </div>
            <div class="flex flex-wrap gap-2" id="theme-buttons">
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 text-white transition-all" data-img="/images/masjid-display/theme-prism-horizon.jpg" data-title="1. Prism Horizon" data-desc="Dock 6 kartu sholat warna-warni pastel di bawah dengan header kaca transparan.">Prism Horizon</button>
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all" data-img="/images/masjid-display/theme-royal-obsidian.jpg" data-title="2. Royal Obsidian" data-desc="Nuansa gelap ultra-premium dengan glassmorphism obsidian dan aksen emas murni champagne gold.">Royal Obsidian</button>
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all" data-img="/images/masjid-display/theme-ottoman-sage.jpg" data-title="3. Ottoman Sage" data-desc="Kombinasi warna alabaster pearl putih gading dengan hijau zamrud khas arsitektur masjid Utsmani.">Ottoman Sage</button>
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all" data-img="/images/masjid-display/theme-andalusian-terracotta.jpg" data-title="4. Andalusian Terracotta" data-desc="Terinspirasi istana Alhambra Spanyol dengan perpaduan terracotta hangat dan sandstone gold.">Andalusian</button>
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all" data-img="/images/masjid-display/theme-emerald-pavilion.jpg" data-title="5. Emerald Pavilion" data-desc="Pilar jadwal sholat di sisi kanan (Right Sidebar) dengan header masjid di kiri atas dan tema zamrud cerah.">Emerald Pavilion</button>
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all" data-img="/images/masjid-display/theme-sidebar-media.jpg" data-title="6. Modern Slate Sidebar" data-desc="Sidebar kiri ~26% canvas dengan header melayang di kanan atas, aksen emas, dan pop-up countdown.">Slate Sidebar</button>
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all" data-img="/images/masjid-display/theme-prism-sidebar.jpg" data-title="7. Prism Sidebar" data-desc="Sidebar kiri pilar dengan kartu sholat multi-warna pastel vertikal.">Prism Sidebar</button>
              <button class="theme-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all" data-img="/images/masjid-display/theme-modern-banner.jpg" data-title="8. Modern Banner" data-desc="Tata letak horizontal klasik dengan banner kaca melayang dan prayer bar bawah modern.">Modern Banner</button>
            </div>
          </div>
          <div class="aspect-video w-full rounded-2xl overflow-hidden border-2 border-slate-700 shadow-2xl bg-black relative">
            <img id="featured-image" src="/images/masjid-display/theme-prism-horizon.jpg" alt="Preview Tampilan TV Masjid Display" class="w-full h-full object-cover transition-opacity duration-300" />
          </div>
        </div>

        <!-- Theme Grid Showcase with Real Thumbnails -->
        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <!-- Theme 1: Prism Horizon -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-emerald-500/50 transition-all shadow-lg group">
            <div class="aspect-video rounded-xl overflow-hidden mb-4 border border-slate-800 bg-black">
              <img src="/images/masjid-display/theme-prism-horizon.jpg" alt="Prism Horizon" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold bg-indigo-900/80 text-indigo-300 px-3 py-1 rounded-full border border-indigo-700">Docking Horizontal</span>
              <span class="text-xs text-slate-400">Tema #1</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">Prism Horizon</h3>
            <p class="text-slate-400 text-xs mb-3">Header kaca transparan minimalis di atas dengan dock 6 kartu sholat warna-warni pastel di bawah.</p>
          </div>

          <!-- Theme 2: Royal Obsidian -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-amber-500/50 transition-all shadow-lg group">
            <div class="aspect-video rounded-xl overflow-hidden mb-4 border border-slate-800 bg-black">
              <img src="/images/masjid-display/theme-royal-obsidian.jpg" alt="Royal Obsidian" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold bg-amber-950/80 text-amber-300 px-3 py-1 rounded-full border border-amber-700">Dark Luxury</span>
              <span class="text-xs text-slate-400">Tema #2</span>
            </div>
            <h3 class="text-lg font-bold text-amber-400 mb-1">Royal Obsidian</h3>
            <p class="text-slate-400 text-xs mb-3">Nuansa gelap ultra-premium dengan efek glassmorphism obsidian dan aksen emas murni champagne gold.</p>
          </div>

          <!-- Theme 3: Ottoman Sage -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-emerald-500/50 transition-all shadow-lg group">
            <div class="aspect-video rounded-xl overflow-hidden mb-4 border border-slate-800 bg-black">
              <img src="/images/masjid-display/theme-ottoman-sage.jpg" alt="Ottoman Sage" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold bg-emerald-950/80 text-emerald-300 px-3 py-1 rounded-full border border-emerald-700">Arsitektur Utsmani</span>
              <span class="text-xs text-slate-400">Tema #3</span>
            </div>
            <h3 class="text-lg font-bold text-emerald-400 mb-1">Ottoman Sage</h3>
            <p class="text-slate-400 text-xs mb-3">Kombinasi warna alabaster pearl putih gading dengan hijau zamrud khas masjid-masjid bersejarah Turki.</p>
          </div>

          <!-- Theme 4: Andalusian Terracotta -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-orange-500/50 transition-all shadow-lg group">
            <div class="aspect-video rounded-xl overflow-hidden mb-4 border border-slate-800 bg-black">
              <img src="/images/masjid-display/theme-andalusian-terracotta.jpg" alt="Andalusian Terracotta" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold bg-orange-950/80 text-orange-300 px-3 py-1 rounded-full border border-orange-700">Warm Ivory</span>
              <span class="text-xs text-slate-400">Tema #4</span>
            </div>
            <h3 class="text-lg font-bold text-orange-400 mb-1">Andalusian Terracotta</h3>
            <p class="text-slate-400 text-xs mb-3">Terinspirasi istana Alhambra Spanyol dengan perpaduan warna terracotta hangat dan sandstone gold.</p>
          </div>

          <!-- Theme 5: Emerald Pavilion -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-emerald-500/50 transition-all shadow-lg group">
            <div class="aspect-video rounded-xl overflow-hidden mb-4 border border-slate-800 bg-black">
              <img src="/images/masjid-display/theme-emerald-pavilion.jpg" alt="Emerald Pavilion" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold bg-teal-950/80 text-teal-300 px-3 py-1 rounded-full border border-teal-700">Right Pillar Sidebar</span>
              <span class="text-xs text-slate-400">Tema #5</span>
            </div>
            <h3 class="text-lg font-bold text-teal-400 mb-1">Emerald Pavilion</h3>
            <p class="text-slate-400 text-xs mb-3">Pilar jadwal sholat di sisi kanan (Right Sidebar) dengan header masjid di kiri atas dan tema hijau zamrud cerah.</p>
          </div>

          <!-- Theme 6: Sidebar Media Modern -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-500/50 transition-all shadow-lg group">
            <div class="aspect-video rounded-xl overflow-hidden mb-4 border border-slate-800 bg-black">
              <img src="/images/masjid-display/theme-sidebar-media.jpg" alt="Modern Slate Sidebar" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold bg-slate-800 text-slate-300 px-3 py-1 rounded-full border border-slate-700">Left Pillar Sidebar</span>
              <span class="text-xs text-slate-400">Tema #6</span>
            </div>
            <h3 class="text-lg font-bold text-slate-200 mb-1">Modern Slate Sidebar</h3>
            <p class="text-slate-400 text-xs mb-3">Sidebar kiri ~26% canvas dengan header melayang di kanan atas, aksen emas, dan pop-up event countdown.</p>
          </div>
        </div>
        <!-- 5 New Features Highlight -->
        <div class="bg-gradient-to-r from-emerald-900/60 to-slate-900 border border-emerald-500/30 rounded-3xl p-8 md:p-12">
          <div class="text-center mb-8">
            <h3 class="text-2xl md:text-3xl font-extrabold text-emerald-300 mb-3">Fitur Koneksi & Pengaturan Baru (v0.1.0)</h3>
            <p class="text-slate-300">Solusi nirkabel cerdas tanpa ribet yang dirancang khusus untuk kenyamanan DKM Masjid.</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800">
              <div class="text-2xl mb-2">⚡</div>
              <h4 class="font-bold text-white mb-1">Smart QR Pairing (&lt; 1 Detik)</h4>
              <p class="text-xs text-slate-400">QR Code menyematkan IP TV langsung. Scan kamera langsung terhubung di Wi-Fi/Hotspot tanpa gagal discovery.</p>
            </div>
            <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800">
              <div class="text-2xl mb-2">⌨️</div>
              <h4 class="font-bold text-white mb-1">Koneksi Manual IP & PIN</h4>
              <p class="text-xs text-slate-400">Cukup ketik IP TV dan PIN jika kamera HP bermasalah. Fleksibel di segala kondisi jaringan.</p>
            </div>
            <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800">
              <div class="text-2xl mb-2">👥</div>
              <h4 class="font-bold text-white mb-1">On-Demand Remote Pairing</h4>
              <p class="text-xs text-slate-400">Tekan tombol OK pada remote TV untuk memunculkan QR pairing kapan saja untuk takmir ke-2, ke-3, dst.</p>
            </div>
            <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800">
              <div class="text-2xl mb-2">🔄</div>
              <h4 class="font-bold text-white mb-1">Auto-Pull Multi-Takmir</h4>
              <p class="text-xs text-slate-400">Buka HP Admin, data aktif dari TV langsung tersinkron otomatis. Form tidak pernah kosong kembali.</p>
            </div>
            <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800">
              <div class="text-2xl mb-2">📍</div>
              <h4 class="font-bold text-white mb-1">Auto-Detect Lokasi GPS</h4>
              <p class="text-xs text-slate-400">1-Klik tombol GPS langsung mengisi koordinat lintang & bujur masjid secara otomatis dan akurat.</p>
            </div>
            <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800">
              <div class="text-2xl mb-2">🕌</div>
              <h4 class="font-bold text-white mb-1">500+ Preset Kota Indonesia</h4>
              <p class="text-xs text-slate-400">Pilih nama kota/kabupaten langsung dari dropdown tanpa perlu mencari koordinat peta manual.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Offline Pillars -->
    <section class="py-20 bg-emerald-50 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-emerald-900 mb-12">Pilar Keunggulan 100% Offline</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-emerald-100 hover:shadow-md transition-shadow">
            <div class="text-4xl mb-4 flex justify-center"><Icon name="wifi-off" size={48} class="text-emerald-600" /></div>
            <h3 class="text-xl font-bold text-emerald-800 mb-3">Bebas Gangguan Internet</h3>
            <p class="text-slate-600">Server mati atau Wi-Fi luar down tidak berpengaruh. Jadwal tetap berputar presisi secara lokal di dalam TV Anda.</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-emerald-100 hover:shadow-md transition-shadow">
            <div class="text-4xl mb-4 flex justify-center"><Icon name="lock" size={48} class="text-emerald-600" /></div>
            <h3 class="text-xl font-bold text-emerald-800 mb-3">Privasi Data Kas & DKM</h3>
            <p class="text-slate-600">Foto pengumuman dan laporan keuangan hanya disimpan di internal TV. Tidak ada data yang bocor ke cloud.</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-emerald-100 hover:shadow-md transition-shadow">
            <div class="text-4xl mb-4 flex justify-center"><Icon name="dollar-sign" size={48} class="text-emerald-600" /></div>
            <h3 class="text-xl font-bold text-emerald-800 mb-3">Investasi Murah Sekali Bayar</h3>
            <p class="text-slate-600">Tidak ada recurring payment Rp 50rb–100rb per bulan. Hemat operasional masjid selamanya.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="py-20 bg-white px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">Perbandingan Biaya</h2>
        <div class="overflow-x-auto rounded-xl shadow-lg border border-slate-200">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-100 text-slate-800">
                <th class="p-4 font-bold border-b border-slate-200">Fitur / Tipe</th>
                <th class="p-4 font-bold border-b border-slate-200">Box LED Konvensional</th>
                <th class="p-4 font-bold border-b border-slate-200 bg-emerald-50 text-emerald-800">Masjid Display Asri Digital</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100 hover:bg-slate-50">
                <td class="p-4 text-slate-600 font-medium">Biaya Awal</td>
                <td class="p-4 text-slate-500">Rp 3.500.000 - Rp 7.000.000</td>
                <td class="p-4 font-bold text-emerald-700 bg-emerald-50/50">Rp 249.000 (Software)</td>
              </tr>
              <tr class="border-b border-slate-100 hover:bg-slate-50">
                <td class="p-4 text-slate-600 font-medium">Hardware</td>
                <td class="p-4 text-slate-500">Modul LED Custom (Sulit diservis)</td>
                <td class="p-4 font-bold text-emerald-700 bg-emerald-50/50">Smart TV Bebas Merk (Mudah dicari)</td>
              </tr>
              <tr class="border-b border-slate-100 hover:bg-slate-50">
                <td class="p-4 text-slate-600 font-medium">Pengaturan</td>
                <td class="p-4 text-slate-500">Remote Fisik / Aplikasi Ribet</td>
                <td class="p-4 font-bold text-emerald-700 bg-emerald-50/50">Aplikasi Android Admin Khusus</td>
              </tr>
              <tr class="hover:bg-slate-50">
                <td class="p-4 text-slate-600 font-medium">Biaya Langganan</td>
                <td class="p-4 text-slate-500">Seringkali Rp 50rb/bulan (Cloud)</td>
                <td class="p-4 font-bold text-emerald-700 bg-emerald-50/50">Gratis Selamanya (100% Offline)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Hardware Compatibility -->
    <section class="py-16 bg-slate-50 px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-slate-900 mb-8">Hardware Compatibility Guide</h2>
        <div class="bg-white rounded-xl shadow p-8 border border-slate-200">
          <ul class="list-disc list-inside space-y-4 text-slate-600 text-lg">
            <li><strong>Android TV:</strong> Mendukung merk seperti Sony, TCL, Xiaomi, Coocaa, Polytron, Akari, dll.</li>
            <li><strong>Android TV Box / STB:</strong> Mendukung ZTE B860H, Fiberhome HG680P, Mi Box, TX3 Mini, dll.</li>
            <li><strong>Spesifikasi Minimum:</strong> OS Android 7.0 (Nougat) hingga Android 14+, RAM minimal 1GB.</li>
            <li><strong>Koneksi Layar:</strong> Bisa disambungkan ke TV atau Monitor dengan port HDMI.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Download & Purchase -->
    <section id="download" class="py-20 bg-emerald-900 text-emerald-50 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12">Mulai Gunakan Masjid Display Sekarang</h2>
        <div class="grid md:grid-cols-2 gap-8">
          
          <!-- Download Card -->
          <div class="bg-emerald-800 rounded-2xl p-8 border border-emerald-700 shadow-xl">
            <h3 class="text-2xl font-bold mb-4 text-amber-400">1. Install Aplikasi</h3>
            <p class="mb-6 text-emerald-200">Install dari Google Play di Android TV dan HP pengurus — gratis untuk TV, update otomatis.</p>
            <div class="space-y-4">
              <a href="https://play.google.com/store/apps/details?id=com.asridigital.masjiddisplay.tv" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full bg-emerald-700 hover:bg-emerald-600 border border-emerald-500 text-white font-bold py-3 px-6 rounded-lg transition-colors">
                <Icon name="download" size={20} /> TV App di Google Play (Gratis)
              </a>
              <a href="https://play.google.com/store/apps/details?id=com.asridigital.masjiddisplay.admin" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
                <Icon name="phone" size={20} /> Admin App di Google Play (Sekali Bayar)
              </a>
              <p class="text-center text-xs text-emerald-300">Android TV/STB tanpa Play Store? <a href="/download/masjid-display#tv" class="underline text-amber-300">Download APK TV di sini</a>.</p>
            </div>
          </div>

          <!-- Purchase Card -->
          <div id="purchase" class="bg-white text-slate-900 rounded-2xl p-8 shadow-xl">
            <h3 class="text-2xl font-bold mb-4 text-emerald-800">2. Beli Admin — Sekali Bayar via Google Play</h3>
