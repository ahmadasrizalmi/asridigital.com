---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Pendaftaran Tester Assalam TV | Dapatkan Voucher Lisensi Admin Gratis";
const description = "Daftar sebagai penguji awal (closed tester) aplikasi Assalam TV di Google Play Store dan terima voucher Lisensi Admin gratis senilai Rp 500.000 untuk masjid Anda.";
---

<BaseLayout title={title} description={description} lang="id" dir="ltr">
  <style>
    .gold-gradient-bg {
      background: linear-gradient(140deg, #E9CE95 0%, #C2953F 100%);
    }
  </style>

  <!-- Header / Navbar Minimal -->
  <header class="bg-[#0A1D31] text-white py-6 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <a href="/assalam-tv" class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl gold-gradient-bg flex items-center justify-center text-[#0A1D31]">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </div>
        <span class="font-extrabold text-lg text-[#F5F2EA]">Assalam TV</span>
      </a>

      <a href="/assalam-tv" class="text-xs sm:text-sm font-semibold text-[#D9B26A] hover:underline flex items-center gap-1">
        <span>&larr; Kembali ke Beranda Assalam TV</span>
      </a>
    </div>
  </header>

  <main class="py-16 bg-[#F7F4EC] text-[#10233A] min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="text-xs font-semibold text-[#5C6A7C] mb-4 flex items-center gap-2">
        <a href="/" class="hover:underline">Beranda</a>
        <span>/</span>
        <a href="/assalam-tv" class="hover:underline">Assalam TV</a>
        <span>/</span>
        <span class="text-[#9A7228]">Pendaftaran Tester</span>
      </nav>

      <!-- Page Header -->
      <div class="mb-12">
        <span class="inline-block px-3 py-1 rounded-full bg-[#D9B26A]/20 border border-[#D9B26A]/40 text-[#9A7228] text-xs font-bold uppercase tracking-wider mb-3">
          PENDAFTARAN TESTER
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#10233A] tracking-tight">
          Daftar Jadi Tester Assalam TV
        </h1>
        <p class="mt-3 text-base sm:text-lg text-[#5C6A7C] max-w-2xl">
          Cukup tiga data: nama, email, dan nomor WhatsApp. Kuota tester terbatas, dan setiap tester yang menyelesaikan uji coba menerima voucher Lisensi Admin gratis.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Form Column (Left 7) -->
        <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-3xl border border-[#E7E0D2] shadow-sm">
          <h2 class="text-xl font-bold text-[#10233A] mb-1">Isi data Anda</h2>
          <p class="text-xs sm:text-sm text-[#5C6A7C] mb-6">
            Data hanya dipakai untuk undangan closed testing Google Play dan pengiriman voucher lisensi.
          </p>

          <form id="tester-form" class="space-y-5">
            <div>
              <label for="nama" class="block text-xs font-bold uppercase tracking-wider text-[#10233A] mb-1.5">
                Nama Lengkap &bull; Nama Masjid
              </label>
              <input
                type="text"
                id="nama"
                name="nama"
                required
                placeholder="Contoh: Ahmad Fauzi — Masjid Al-Ikhlas"
                class="w-full px-4 py-3 rounded-xl border border-[#E7E0D2] text-sm text-[#10233A] focus:outline-none focus:border-[#9A7228] transition"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-[#10233A] mb-1.5">
                Email Akun Google Play
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="nama@gmail.com (Email yang terpasang di Android TV/HP)"
                class="w-full px-4 py-3 rounded-xl border border-[#E7E0D2] text-sm text-[#10233A] focus:outline-none focus:border-[#9A7228] transition"
              />
            </div>

            <div>
              <label for="whatsapp" class="block text-xs font-bold uppercase tracking-wider text-[#10233A] mb-1.5">
                Nomor WhatsApp
              </label>
              <input
                type="tel"
                id="whatsapp"
                name="whatsapp"
                required
                placeholder="Contoh: 081234567890"
                class="w-full px-4 py-3 rounded-xl border border-[#E7E0D2] text-sm text-[#10233A] focus:outline-none focus:border-[#9A7228] transition"
              />
            </div>

            <div>
              <label for="device" class="block text-xs font-bold uppercase tracking-wider text-[#10233A] mb-1.5">
                Jenis Perangkat TV yang Digunakan
              </label>
              <select
                id="device"
                name="device"
                class="w-full px-4 py-3 rounded-xl border border-[#E7E0D2] text-sm text-[#10233A] focus:outline-none focus:border-[#9A7228] transition bg-white"
              >
                <option value="Smart TV Android / Google TV">Smart TV Android / Google TV (Sony, TCL, Mi TV, dll)</option>
                <option value="Android TV Box / STB">Android TV Box / STB (Mi Box, Indihome unlock, dll)</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>

            <p class="text-[11px] text-[#5C6A7C] leading-relaxed pt-1">
              Dengan mendaftar, Anda menyetujui <a href="/assalam-tv/terms" class="text-[#9A7228] underline">Syarat &amp; Ketentuan</a> serta <a href="/assalam-tv/privacy" class="text-[#9A7228] underline">Kebijakan Privasi</a> Assalam TV.
            </p>

            <button
              type="submit"
              id="submit-btn"
              class="w-full py-4 rounded-xl gold-gradient-bg text-[#0A1D31] font-extrabold text-sm shadow-md hover:brightness-105 transition disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
            >
              <span>Kirim Pendaftaran</span>
            </button>
          </form>

          <div id="error-msg" class="hidden mt-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm">
            <span id="error-text">Terjadi kendala saat mengirim formulir. Silakan coba lagi atau kirim via WhatsApp.</span>
          </div>

          <div id="success-msg" class="hidden mt-6 p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-lg flex-shrink-0">
                &check;
              </div>
              <div>
                <h3 class="font-extrabold text-sm sm:text-base text-emerald-950">Alhamdulillah, Pendaftaran Berhasil Tersimpan!</h3>
                <p class="text-xs text-emerald-800 mt-0.5">Data Anda telah masuk ke sistem antrean closed testing Google Play Asri Digital.</p>
              </div>
            </div>

            <div class="p-3.5 bg-white/80 rounded-xl text-xs text-emerald-950 space-y-1.5 border border-emerald-100">
              <p><strong>Langkah selanjutnya:</strong></p>
              <p>&bull; Tim kami akan mendaftarkan email Google Play Anda ke Google Play Console dalam waktu maksimal 1x24 jam kerja.</p>
              <p>&bull; Tautan undangan resmi closed testing &amp; kode voucher Lisensi Admin gratis akan dikirimkan ke email dan nomor WhatsApp Anda.</p>
            </div>

            <a
              id="wa-confirm-btn"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm transition shadow"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              <span>Konfirmasi Cepat via WhatsApp (Opsional)</span>
            </a>
          </div>
        </div>

        <!-- Side Benefits & Steps (Right 5) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- What You Get Card -->
          <div class="p-6 rounded-3xl bg-white border border-[#E7E0D2] shadow-sm">
            <h3 class="text-sm font-extrabold uppercase tracking-wider text-[#9A7228] mb-4">Yang Anda dapat</h3>
            <ul class="space-y-3 text-xs sm:text-sm text-[#10233A]">
              <li class="flex items-start gap-2.5">
                <span class="text-[#9A7228] font-bold">&check;</span>
                <span>Voucher Lisensi Admin gratis (senilai Rp 500.000)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-[#9A7228] font-bold">&check;</span>
                <span>Akses lebih awal ke semua 18 tema &amp; fitur sholat</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-[#9A7228] font-bold">&check;</span>
                <span>Masukan Anda menentukan penyempurnaan versi final</span>
              </li>
            </ul>
          </div>

          <!-- Quick Flow Card -->
          <div class="p-6 rounded-3xl bg-white border border-[#E7E0D2] shadow-sm">
            <h3 class="text-sm font-extrabold uppercase tracking-wider text-[#9A7228] mb-4">Alur singkat</h3>
            <div class="space-y-3 text-xs sm:text-sm text-[#5C6A7C]">
              <div class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#D9B26A]/20 text-[#9A7228] font-bold text-xs flex items-center justify-center flex-shrink-0">1</span>
                <span class="text-[#10233A]">Isi formulir ini</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#D9B26A]/20 text-[#9A7228] font-bold text-xs flex items-center justify-center flex-shrink-0">2</span>
                <span class="text-[#10233A]">Data tersimpan &amp; kami kirim undangan closed testing Google Play</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#D9B26A]/20 text-[#9A7228] font-bold text-xs flex items-center justify-center flex-shrink-0">3</span>
                <span class="text-[#10233A]">Coba pasang di TV masjid selama masa uji coba</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#D9B26A]/20 text-[#9A7228] font-bold text-xs flex items-center justify-center flex-shrink-0">4</span>
                <span class="text-[#10233A]">Voucher Lisensi Admin dikirim via email/WhatsApp</span>
              </div>
            </div>
          </div>

          <!-- WhatsApp Direct -->
          <div class="p-6 rounded-3xl bg-[#0E2A47] text-white border border-[#D9B26A]/40 shadow-sm">
            <h3 class="text-sm font-bold text-[#F5F2EA] mb-1">Butuh bantuan?</h3>
            <p class="text-xs text-[#A7B4C6] mb-4">
              Tanya kompatibilitas perangkat atau konsultasikan TV masjid Anda lewat WhatsApp.
            </p>
            <a
              href="https://wa.me/6281325063888?text=Halo%20Asri%20Digital,%20saya%20ingin%20konsultasi%20pendaftaran%20tester%20Assalam%20TV"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl gold-gradient-bg text-[#0A1D31] font-bold text-xs shadow hover:brightness-105 transition"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              <span>Tanya via WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    const form = document.getElementById('tester-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');
    const errorText = document.getElementById('error-text');
    const waConfirmBtn = document.getElementById('wa-confirm-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const nama = document.getElementById('nama')?.value?.trim();
      const email = document.getElementById('email')?.value?.trim();
      const whatsapp = document.getElementById('whatsapp')?.value?.trim();
      const device = document.getElementById('device')?.value;

      if (!nama || !email || !whatsapp) return;

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Menyimpan pendaftaran...</span>';
      if (errorMsg) errorMsg.classList.add('hidden');

      const waText = encodeURIComponent(`Halo Asri Digital, saya sudah mendaftar sebagai Tester Assalam TV via website:\n\nNama/Masjid: ${nama}\nEmail Google Play: ${email}\nNo. WhatsApp: ${whatsapp}\nPerangkat TV: ${device}\n\nMohon link undangan closed testing & voucher lisensi adminnya. Terima kasih!`);
      const waUrl = `https://wa.me/6281325063888?text=${waText}`;
      if (waConfirmBtn) waConfirmBtn.href = waUrl;

      try {
        const res = await fetch('/api/assalam-tv/tester', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nama, email, whatsapp, device })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          form.style.display = 'none';
          if (successMsg) successMsg.classList.remove('hidden');
        } else {
          throw new Error(data.error || 'Gagal menyimpan pendaftaran');
        }
      } catch (err) {
        // Fallback: If network / server error, allow direct WhatsApp submission
        console.warn('API error, falling back to direct WhatsApp:', err);
        form.style.display = 'none';
        if (successMsg) successMsg.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
