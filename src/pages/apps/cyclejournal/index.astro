---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';

const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.app.cyclejournal';
const PRIVACY_URL = '/apps/cyclejournal/privacy';

const title = 'CycleJournal: Kalender Haid & Laporan SpOG | Asri Digital Apps';
const description = 'Aplikasi kalender haid dan jurnal kesuburan 100% offline-first dengan enkripsi zero-knowledge, deteksi anomali FIGO, dan laporan PDF siap dokter SpOG.';

const screenshots = [
  { file: '01-dashboard.png', title: 'Dasbor Siklus', sub: 'Fase hormonal, hari ke-siklus, dan tren BBT.' },
  { file: '02-daily-log.png', title: 'Jurnal Gejala', sub: 'Catat BBT, lendir serviks, dan skala nyeri VAS 0–10.' },
  { file: '03-medical-report.png', title: 'Laporan Medis', sub: 'PDF A4 dengan metrik FIGO & red flags klinis.' },
  { file: '04-privacy-security.png', title: 'Privasi & Keamanan', sub: 'Kunci PIN, biometrik, dan enkripsi SQLCipher.' },
  { file: '05-data-portability.png', title: 'Kedaulatan Data', sub: 'CSV Excel-ready & hapus total data dalam satu sentuhan.' },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="flex-grow">
    <!-- ============ HERO SECTION ============ -->
    <section class="relative overflow-hidden bg-slate-900 text-white pt-10 pb-16 lg:pt-16 lg:pb-24 border-b border-slate-800">
      <div aria-hidden class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(255,94,125,0.28),transparent_70%)]"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-400">
          <a href="/" class="hover:text-coral-400 transition">Asri Digital</a><span class="text-slate-600">/</span>
          <a href="/apps" class="hover:text-coral-400 transition">Apps</a><span class="text-slate-600">/</span>
          <span class="rounded-full bg-slate-800 border border-slate-700 px-2.5 py-0.5 font-semibold text-coral-300">CycleJournal</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 rounded-full border border-coral-500/30 bg-coral-950/70 px-3.5 py-1 text-xs font-semibold text-coral-300 mb-5 backdrop-blur">
              <span class="h-2 w-2 rounded-full bg-coral-400 animate-pulse"></span>
              Kalender Haid &amp; Jurnal Kesuburan Medis
            </div>

            <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl xl:text-5xl leading-[1.15]">
              Siklus &amp; Jurnal Intim <span class="bg-gradient-to-r from-coral-300 to-coral-500 bg-clip-text text-transparent">100% Offline &amp; Zero-Knowledge</span>
            </h1>

            <p class="mt-5 max-w-2xl text-base text-slate-300 leading-relaxed sm:text-lg mx-auto lg:mx-0">
              Kalender haid, masa subur, dan jurnal biomedis berstandar <strong class="text-white">FIGO</strong> dengan enkripsi <strong class="text-white">SQLCipher</strong> di perangkat. Cadangan cloud opsional dienkripsi <strong class="text-white">AES-256 di sisi klien</strong> — server tak pernah melihat isi data Anda.
            </p>

            <div class="mt-6 flex flex-wrap justify-center lg:justify-start gap-4 text-xs font-medium text-slate-300">
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700">
                <svg class="w-4 h-4 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg><span>FIGO Standard</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700">
                <svg class="w-4 h-4 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg><span>100% Offline &amp; Zero-Knowledge</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700">
                <svg class="w-4 h-4 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg><span>Ekspor PDF &amp; CSV</span>
              </div>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-white text-slate-900 font-extrabold text-sm shadow-xl shadow-coral-500/10 hover:bg-coral-50 hover:shadow-coral-500/20 transition-all transform hover:-translate-y-0.5">
                <svg class="h-6 w-6 flex-shrink-0" viewBox="0 0 24 24" fill="none">
                  <path d="M3.609 1.814L13.792 12 3.61 22.186c-.234-.23-.37-.549-.37-.899V2.713c0-.35.136-.669.37-.899z" fill="#00E676"/>
                  <path d="M17.18 8.613L4.852 1.501c-.382-.22-.843-.205-1.243.037L13.792 12l3.388-3.387z" fill="#FFD54F"/>
                  <path d="M13.792 12l-10.183 10.462c.4.242.861.257 1.243.037l12.328-7.112L13.792 12z" fill="#FF3D00"/>
                  <path d="M20.573 10.57l-3.393-1.957L13.792 12l3.388 3.387 3.393-1.958c.758-.438 1.227-1.242 1.227-2.116s-.469-1.678-1.227-2.116z" fill="#40C4FF"/>
                </svg>
                <div class="text-left"><div class="text-[10px] uppercase tracking-wider text-slate-500 font-bold leading-none">GET IT ON</div><div class="text-sm font-black leading-tight text-slate-900">Google Play</div></div>
              </a>
              <a href="#fitur" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl border border-slate-700 bg-slate-800/60 text-slate-200 font-bold text-sm hover:bg-slate-800 hover:text-white transition">
                <span>Pelajari Fitur Unggulan</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </a>
            </div>

            <p class="mt-4 text-xs text-slate-400 flex items-center justify-center lg:justify-start gap-2">
              <svg class="w-3.5 h-3.5 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>Tanpa pendaftaran akun • Data tetap di ponsel Anda</span>
            </p>
          </div>

          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-xs sm:max-w-sm">
              <div class="rounded-3xl border border-slate-700/60 bg-slate-800/40 p-2 shadow-2xl backdrop-blur">
                <img src="/images/apps/cyclejournal/01-dashboard.png" alt="Tampilan utama CycleJournal: kalender siklus dan fase kesuburan" class="w-full rounded-2xl shadow-inner object-cover" loading="eager" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROBLEM VS SOLUTION ============ -->
    <section class="py-16 bg-white border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-wider text-coral-600">Problem &amp; Solution</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Kenapa Aplikasi Ini Diciptakan?</h2>
          <p class="text-slate-500 text-sm mt-3">Data kesehatan reproduksi sangat sensitif. Banyak aplikasi populer penuh iklan, langganan mahal, dan rawan isu privasi data.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="p-8 rounded-3xl bg-rose-50/70 border border-rose-200">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-200/80 text-rose-800 text-xs font-bold mb-4">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg> Masalah
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Aplikasi haid umum: penuh iklan &amp; data bocor</h3>
            <p class="text-sm text-slate-600 leading-relaxed">Data kesehatan diproses di server pihak ketiga, langganan bulanan mahal, dan laporan tidak enak dibaca dokter kandungan. Privasi data reproduksi sering terabaikan demi iklan.</p>
          </div>
          <div class="p-8 rounded-3xl bg-emerald-50/70 border border-emerald-200">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-200/80 text-emerald-800 text-xs font-bold mb-4">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Solusi
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">CycleJournal: medical-grade &amp; privacy-first</h3>
            <p class="text-sm text-slate-600 leading-relaxed">100% offline-first dengan enkripsi SQLCipher di perangkat, laporan PDF A4 siap dokter SpOG, dan beli putus sekali tanpa tagihan bulanan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FITUR UTAMA ============ -->
    <section id="fitur" class="py-20 bg-slate-50 border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="text-xs font-bold uppercase tracking-wider text-coral-600">Fitur Utama</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Didesain untuk Kebutuhan Medis Nyata</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-soft">
            <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center mb-4 font-black text-lg"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg></div>
            <h3 class="font-bold text-slate-900 text-base mb-2">Laporan PDF Siap SpOG</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Ekspor ringkasan klinis A4 1-halaman dengan metrik FIGO, red flags anomali, tabel riwayat siklus, dan kotak tanda tangan dokter.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-soft">
            <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center mb-4 font-black text-lg"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg></div>
            <h3 class="font-bold text-slate-900 text-base mb-2">100% Offline &amp; Zero-Knowledge</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Semua data terenkripsi hardware (SQLCipher). Cadangan cloud opsional dienkripsi AES-256-GCM di sisi klien — server tak pernah melihat isinya.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-soft">
            <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center mb-4 font-black text-lg"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg></div>
            <h3 class="font-bold text-slate-900 text-base mb-2">Deteksi Anomali FIGO</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Screening otomatis untuk oligomenorea, polimenorea, siklus tak teratur, perdarahan memanjang, spotting, fase luteal pendek, dan dismenore berat.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-soft">
            <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center mb-4 font-black text-lg"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg></div>
            <h3 class="font-bold text-slate-900 text-base mb-2">Kedaulatan Data</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Ekspor data mentah ke CSV (Excel-ready) kapan pun, sinkronisasi backup bulanan, dan hapus total seluruh data dalam satu sentuhan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ GALLERY SCREENSHOT ============ -->
    <section class="py-20 bg-white border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-wider text-coral-600">Alur Penggunaan</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Tangkapan Layar Resmi Aplikasi</h2>
          <p class="text-slate-500 text-sm mt-3">Geser untuk melihat antarmuka bersih dan modern tanpa emoji.</p>
        </div>
        <div class="flex gap-6 overflow-x-auto pb-6 pt-2 snap-x snap-mandatory scrollbar-thin">
          {screenshots.map((s) => (
            <div class="flex-shrink-0 w-64 sm:w-72 snap-center">
              <div class="rounded-3xl border border-slate-200 bg-slate-50 p-2.5 shadow-md hover:shadow-xl transition-all">
                <img src={`/images/apps/cyclejournal/${s.file}`} alt={s.title} class="w-full rounded-2xl shadow-inner aspect-[9/16] object-cover" loading="lazy" />
              </div>
              <div class="mt-3 text-center px-2"><h4 class="font-bold text-slate-900 text-sm">{s.title}</h4><p class="text-xs text-slate-500 mt-1">{s.sub}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ PRICING TIERS ============ -->
    <section class="py-20 bg-slate-50 border-b border-slate-100">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="text-xs font-bold uppercase tracking-wider text-coral-600">Skema Akses</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Pilihan Transparan Tanpa Langganan</h2>
          <p class="text-slate-500 text-sm mt-3">Model beli putus sekali bayar tanpa tagihan bulanan.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-soft flex flex-col justify-between">
            <div>
              <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Free Tier</div>
              <div class="text-2xl font-black text-slate-900 mt-2">Gratis</div>
              <p class="text-xs text-slate-500 mt-2">Pelacakan dasar dan kalender siklus tanpa biaya.</p>
              <ul class="mt-6 space-y-3 text-xs text-slate-600">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-coral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Kalender &amp; prediksi masa subur</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-coral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Jurnal gejala harian</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-coral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Ekspor PDF dengan iklan singkat</li>
              </ul>
            </div>
            <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="mt-8 block text-center py-3 rounded-xl border border-slate-300 font-bold text-xs text-slate-700 hover:bg-slate-50 transition">Unduh Gratis</a>
          </div>
          <div class="p-8 rounded-3xl bg-gradient-to-b from-slate-900 to-slate-800 text-white border border-slate-700 shadow-xl relative flex flex-col justify-between">
            <div class="absolute -top-3.5 right-6 px-3 py-1 rounded-full bg-coral-400 text-slate-950 font-extrabold text-[10px] uppercase tracking-wider">Best Value</div>
            <div>
              <div class="text-xs font-bold text-coral-300 uppercase tracking-wider">Lifetime Pro</div>
              <div class="text-3xl font-black text-white mt-2">Rp 49.000</div>
              <p class="text-xs text-slate-400 mt-2">Beli putus sekali untuk selamanya. Tanpa langganan.</p>
              <ul class="mt-6 space-y-3 text-xs text-slate-300">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Ekspor PDF tanpa batas (tanpa iklan)</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Sinkronisasi backup cloud otomatis</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 100% bebas iklan selamanya</li>
              </ul>
            </div>
            <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="mt-8 block text-center py-3.5 rounded-xl bg-coral-400 text-slate-950 font-extrabold text-xs shadow-lg hover:bg-coral-300 transition">Buka Versi PRO di Play Store</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA & LEGAL ============ -->
    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Mulai Catat Siklus Anda dengan Aman Sekarang</h2>
        <p class="text-slate-500 text-sm mt-3 max-w-xl mx-auto">Unduh langsung dari Google Play Store dan kendalikan penuh data kesehatan reproduksi Anda.</p>
        <div class="mt-8 flex justify-center">
          <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-slate-900 text-white font-extrabold text-sm shadow-xl hover:bg-slate-800 transition">
            <svg class="h-6 w-6 flex-shrink-0" viewBox="0 0 24 24" fill="none"><path d="M3.609 1.814L13.792 12 3.61 22.186c-.234-.23-.37-.549-.37-.899V2.713c0-.35.136-.669.37-.899z" fill="#00E676"/><path d="M17.18 8.613L4.852 1.501c-.382-.22-.843-.205-1.243.037L13.792 12l3.388-3.387z" fill="#FFD54F"/><path d="M13.792 12l-10.183 10.462c.4.242.861.257 1.243.037l12.328-7.112L13.792 12z" fill="#FF3D00"/><path d="M20.573 10.57l-3.393-1.957L13.792 12l3.388 3.387 3.393-1.958c.758-.438 1.227-1.242 1.227-2.116s-.469-1.678-1.227-2.116z" fill="#40C4FF"/></svg>
            <div class="text-left"><div class="text-[10px] uppercase tracking-wider text-slate-400 font-bold leading-none">GET IT ON</div><div class="text-base font-black leading-tight text-white">Google Play Store</div></div>
          </a>
        </div>
        <div class="mt-12 pt-8 border-t border-slate-100 flex flex-wrap justify-center items-center gap-6 text-xs text-slate-500">
          <a href={PRIVACY_URL} class="hover:text-coral-600 font-semibold underline underline-offset-2 transition">Kebijakan Privasi (Privacy Policy)</a><span>&bull;</span>
          <a href="/terms" class="hover:text-coral-600 font-medium transition">Syarat &amp; Ketentuan</a><span>&bull;</span>
          <a href="/contact" class="hover:text-coral-600 font-medium transition">Kontak Pengembang</a>
        </div>
        <p class="mt-8 text-[11px] text-slate-400 max-w-2xl mx-auto leading-relaxed">
          <strong>Disclaimer Medis:</strong> CycleJournal adalah alat pencatatan klinis pribadi untuk referensi dokter kandungan dan bukan pengganti diagnosis medis profesional, bukan alat kontrasepsi, dan tidak boleh digunakan sebagai satu-satunya dasar keputusan kesehatan.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
