---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const title = 'Aplikasi Resmi Kami | Asri Digital Apps';
const description = 'Portofolio aplikasi Android dan Android TV resmi karya Asri Digital. Dirancang untuk keandalan 100% offline, performa tinggi, dan utilitas nyata.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="flex-grow bg-slate-50">
    <!-- Header Hero -->
    <section class="relative py-16 bg-white border-b border-slate-100 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-200">
          Native Android Portfolio
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Aplikasi Resmi Karya Asri Digital
        </h1>
        <p class="mt-4 max-w-2xl mx-auto text-base text-slate-500">
          Kami membangun dan memelihara produk aplikasi mandiri yang digunakan oleh ribuan pengguna aktif dengan arsitektur 100% offline dan performa native teruji.
        </p>
      </div>
    </section>

    <!-- Apps Grid -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-8">

          <!-- Card 1: Japanese PDF to Word -->
          <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white shadow-md font-bold text-xl">
                    <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                  </div>
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded-full border border-blue-100">Utility &bull; Education</span>
                    <h2 class="text-xl font-extrabold text-slate-900 mt-1">Japanese PDF to Word</h2>
                    <p class="text-xs text-slate-500">Furigana Ruby Edition &bull; 100% Offline</p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="inline-block text-xs font-extrabold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md border border-blue-200">
                    Versi 1.0.0
                  </span>
                  <p class="text-[10px] text-slate-400 mt-1">Android 14 Ready</p>
                </div>
              </div>

              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                Solusi cerdas bagi pelajar dan pengajar bahasa Jepang untuk mengonversi PDF materi JLPT ke dokumen Word (.docx) tanpa merusak bacaan furigana di atas kanji dan susunan tabel kosakata.
              </p>

              <!-- App Preview Images -->
              <div class="grid grid-cols-3 gap-3 mb-6 p-3 bg-slate-50 rounded-2xl border border-slate-100">
                <img src="/images/apps/japanese-pdf-to-word/01-home.png" alt="Pilih Dokumen PDF" class="rounded-xl aspect-[9/16] object-cover shadow-sm w-full" loading="lazy" />
                <img src="/images/apps/japanese-pdf-to-word/02-options.png" alt="Opsi Pengaturan Furigana" class="rounded-xl aspect-[9/16] object-cover shadow-sm w-full" loading="lazy" />
                <img src="/images/apps/japanese-pdf-to-word/05-docx.png" alt="Hasil Dokumen Word Rapi" class="rounded-xl aspect-[9/16] object-cover shadow-sm w-full" loading="lazy" />
              </div>
            </div>

              <a href="https://play.google.com/store/apps/details?id=com.kandaapps.japanesepdftoword" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition">
                <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none">
                  <path d="M3.609 1.814L13.792 12 3.61 22.186c-.234-.23-.37-.549-.37-.899V2.713c0-.35.136-.669.37-.899z" fill="#00E676"/>
                  <path d="M17.18 8.613L4.852 1.501c-.382-.22-.843-.205-1.243.037L13.792 12l3.388-3.387z" fill="#FFD54F"/>
                  <path d="M13.792 12l-10.183 10.462c.4.242.861.257 1.243.037l12.328-7.112L13.792 12z" fill="#FF3D00"/>
                  <path d="M20.573 10.57l-3.393-1.957L13.792 12l3.388 3.387 3.393-1.958c.758-.438 1.227-1.242 1.227-2.116s-.469-1.678-1.227-2.116z" fill="#40C4FF"/>
                </svg>
                <span>Google Play</span>
              </a>
              <a href="/apps/japanese-pdf-to-word" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl border border-slate-200 font-bold text-xs text-slate-700 hover:bg-slate-50 transition">
                <span>Pelajari Detail Aplikasi</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </a>
            </div>
          </div>

          <!-- Card 2: Masjid Display -->
          <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-800 flex items-center justify-center text-white shadow-md font-bold text-xl">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                      <line x1="8" y1="21" x2="16" y2="21"></line>
                      <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                  </div>
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">Android TV &bull; Community</span>
                    <h2 class="text-xl font-extrabold text-slate-900 mt-1">Masjid Display</h2>
                    <p class="text-xs text-slate-500">Sistem Display TV &bull; Remote Wi-Fi Offline</p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="inline-block text-xs font-extrabold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                    Versi 0.7.4
                  </span>
                  <p class="text-[10px] text-slate-400 mt-1">TV &amp; Smartphone</p>
                </div>
              </div>

              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                Sistem informasi masjid dan jadwal sholat presisi untuk Android TV. Dapat dikontrol penuh melalui smartphone pengurus lewat jaringan Wi-Fi lokal tanpa internet dan tanpa biaya bulanan.
              </p>

              <!-- App Preview Images -->
              <div class="p-3 bg-slate-50 rounded-2xl border border-slate-100 mb-6">
                <img src="/images/masjid-display/lp-tv-classic-horizontal.jpg" alt="Tampilan Layar Masjid Display" class="rounded-xl aspect-video object-cover shadow-sm w-full" loading="lazy" />
              </div>
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
              <a href="https://play.google.com/store/apps/details?id=com.asridigital.masjiddisplay.admin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition">
                <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none">
                  <path d="M3.609 1.814L13.792 12 3.61 22.186c-.234-.23-.37-.549-.37-.899V2.713c0-.35.136-.669.37-.899z" fill="#00E676"/>
                  <path d="M17.18 8.613L4.852 1.501c-.382-.22-.843-.205-1.243.037L13.792 12l3.388-3.387z" fill="#FFD54F"/>
                  <path d="M13.792 12l-10.183 10.462c.4.242.861.257 1.243.037l12.328-7.112L13.792 12z" fill="#FF3D00"/>
                  <path d="M20.573 10.57l-3.393-1.957L13.792 12l3.388 3.387 3.393-1.958c.758-.438 1.227-1.242 1.227-2.116s-.469-1.678-1.227-2.116z" fill="#40C4FF"/>
                </svg>
                <span>Google Play</span>
              </a>
              <a href="/masjid-display" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl border border-slate-200 font-bold text-xs text-slate-700 hover:bg-slate-50 transition">
                <span>Pelajari Detail Aplikasi</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
