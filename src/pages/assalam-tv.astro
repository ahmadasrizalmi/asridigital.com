  <!-- ==================== CLIENT INTERACTION SCRIPT ==================== -->
  <script is:inline>
    // 1. Mobile Menu Drawer Toggle
    const mobileBtn = document.getElementById('mobile-menu-toggle-btn');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');
    if (mobileBtn && mobileDrawer) {
      mobileBtn.addEventListener('click', () => {
        mobileDrawer.classList.toggle('hidden');
      });
      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileDrawer.classList.add('hidden');
        });
      });
    }

    // 2. Carousel Data (8 slides dari spesifikasi Pencil .pen)
    const slides = [
      {
        title: "01 \u2022 Bahasa Indonesia \u2022 Horizontal Classic",
        desc: "Tema Andalusia (emas terakota hangat) \u2022 id-h-andalusia.png",
        img: "/images/assalam-tv/id-h-andalusia.png"
      },
      {
        title: "02 \u2022 English \u2022 Sidebar Kiri",
        desc: "Tema Lazuardi (biru safir damai) \u2022 en-sidebar-lazuardi.png",
        img: "/images/assalam-tv/en-sidebar-lazuardi.png"
      },
      {
        title: "03 \u2022 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u2022 Sidebar Kanan",
        desc: "Tema Nila (ungu indigo berwibawa) \u2022 ar-kanan-nila.png",
        img: "/images/assalam-tv/ar-kanan-nila.png"
      },
      {
        title: "04 \u2022 Notifikasi Adzan \u2022 Horizontal",
        desc: "Tema Lazuardi (biru) \u2022 id-s-lazuardi-adzan.png",
        img: "/images/assalam-tv/id-s-lazuardi-adzan.png"
      },
      {
        title: "05 \u2022 Countdown Iqomah \u2022 Horizontal",
        desc: "Tema Andalusia (emas) \u2022 id-s-andalusia-iqamah.png",
        img: "/images/assalam-tv/id-s-andalusia-iqamah.png"
      },
      {
        title: "06 \u2022 Notifikasi Sholat Jumat \u2022 Horizontal",
        desc: "Tema Lazuardi (biru) \u2022 id-s-lazuardi-jumat.png",
        img: "/images/assalam-tv/id-s-lazuardi-jumat.png"
      },
      {
        title: "07 \u2022 Countdown Dhuha \u2022 Horizontal",
        desc: "Tema Andalusia (emas) \u2022 id-s-andalusia-dhuha.png",
        img: "/images/assalam-tv/id-s-andalusia-dhuha.png"
      },
      {
        title: "08 \u2022 Menjelang Sholat \u2022 Horizontal",
        desc: "Tema Lazuardi (biru) \u2022 id-s-lazuardi-menjelang.png",
        img: "/images/assalam-tv/id-s-lazuardi-menjelang.png"
      }
    ];

    let currentSlide = 0;
    const carouselImg = document.getElementById('carousel-main-image');
    const carouselTitle = document.getElementById('carousel-active-title');
    const carouselDesc = document.getElementById('carousel-active-desc');
    const dotsContainer = document.getElementById('carousel-dots');
    const dots = dotsContainer ? dotsContainer.querySelectorAll('.dot-btn') : [];

    function updateSlide(index) {
      if (index < 0) currentSlide = slides.length - 1;
      else if (index >= slides.length) currentSlide = 0;
      else currentSlide = index;

      const item = slides[currentSlide];
      if (carouselImg) {
        carouselImg.style.opacity = '0.3';
        setTimeout(() => {
          carouselImg.src = item.img;
          carouselImg.style.opacity = '1';
        }, 150);
      }
      if (carouselTitle) carouselTitle.textContent = item.title;
      if (carouselDesc) carouselDesc.textContent = item.desc;

      dots.forEach((dot, idx) => {
        if (idx === currentSlide) {
          dot.classList.add('bg-[#D9B26A]', 'scale-125');
          dot.classList.remove('bg-white/30');
        } else {
          dot.classList.remove('bg-[#D9B26A]', 'scale-125');
          dot.classList.add('bg-white/30');
        }
      });
    }

    document.getElementById('carousel-prev')?.addEventListener('click', () => updateSlide(currentSlide - 1));
    document.getElementById('carousel-next')?.addEventListener('click', () => updateSlide(currentSlide + 1));

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => updateSlide(idx));
    });

    document.querySelectorAll('.theme-select-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        updateSlide(idx);
        document.querySelectorAll('.theme-select-btn').forEach(b => {
          b.classList.remove('bg-[#D9B26A]', 'text-[#0A1D31]');
          b.classList.add('bg-white/10', 'text-white');
        });
        btn.classList.add('bg-[#D9B26A]', 'text-[#0A1D31]');
        btn.classList.remove('bg-white/10', 'text-white');
      });
    });

    // 3. FAQ Accordion Toggle
    document.querySelectorAll('.faq-item').forEach(item => {
      const toggle = item.querySelector('.faq-toggle');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');

      toggle?.addEventListener('click', () => {
        const isClosed = content?.classList.contains('hidden');
        // Tutup yang lain
        document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('.faq-icon').forEach(ic => ic.innerHTML = '&plus;');

        if (isClosed && content && icon) {
          content.classList.remove('hidden');
          icon.innerHTML = '&minus;';
        }
      });
    });
  </script>
