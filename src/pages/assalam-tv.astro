---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';

const title = "Assalam TV | Jam Sholat Digital Masjid & Theme Premium 100% Offline";
const description = "Aplikasi jadwal sholat digital TV masjid modern. 18 tema mewah, dukungan TV vertikal standing totem, kontrol penuh dari HP via Wi-Fi tanpa kuota & tanpa biaya bulanan.";
const ogImage = "https://asridigital.com/images/assalam-tv/id-h-andalusia.png";
---

<BaseLayout title={title} description={description} ogImage={ogImage} lang="id" dir="ltr">
  <!-- Styles khusus Assalam TV Design System (Pencil/Pen variables) -->
  <style>
    :root {
      --color-brand-ink: #0A1D31;
      --color-brand-ink2: #0E2A47;
      --color-brand-ink3: #16395C;
      --color-gold: #D9B26A;
      --color-gold-soft: #EBD3A0;
      --color-gold-deep: #9A7228;
      --color-ivory: #F7F4EC;
      --color-paper: #FFFFFF;
      --color-line: #E7E0D2;
      --color-ink: #10233A;
      --color-muted: #5C6A7C;
      --color-ink-light: #F5F2EA;
      --color-muted-light: #A7B4C6;
    }

    .font-cairo {
      font-family: 'Cairo', 'Plus Jakarta Sans', sans-serif;
    }

    .gold-gradient-bg {
      background: linear-gradient(140deg, #E9CE95 0%, #C2953F 100%);
    }

    .gold-gradient-text {
      background: linear-gradient(140deg, #F5E5C0 0%, #D9B26A 60%, #B88930 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-glow-1 {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(217, 178, 106, 0.12) 0%, rgba(10, 29, 49, 0) 70%);
      top: -100px;
      right: 10%;
      pointer-events: none;
    }

    .hero-glow-2 {
      position: absolute;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(27, 58, 107, 0.4) 0%, rgba(6, 20, 35, 0) 70%);
      bottom: 50px;
      left: -100px;
      pointer-events: none;
    }

    .ring-decor {
      border: 1px solid rgba(217, 178, 106, 0.12);
      border-radius: 50%;
      pointer-events: none;
      position: absolute;
    }

    .tv-frame-shadow {
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 40px -10px rgba(217, 178, 106, 0.25);
    }
  </style>

  <!-- ==================== 0. NAVBAR ==================== -->
  <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#0A1D31]/90 backdrop-blur-md border-b border-[#D9B26A]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Brand -->
        <a href="/assalam-tv" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl gold-gradient-bg flex items-center justify-center text-[#0A1D31] shadow-md group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </div>
          <div>
            <div class="text-[#F5F2EA] font-extrabold text-lg sm:text-xl tracking-tight leading-none">
              Assalam TV
            </div>
            <div class="text-[#D9B26A] text-[11px] font-medium tracking-wide mt-0.5">
              by Asri Digital
            </div>
          </div>
        </a>

        <!-- Desktop Links -->
        <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium text-[#B9C6D6]">
          <a href="#themes" class="hover:text-[#D9B26A] transition-colors">Tema &amp; Warna</a>
          <a href="#vertical" class="hover:text-[#D9B26A] transition-colors">Tampilan Vertikal</a>
          <a href="#features" class="hover:text-[#D9B26A] transition-colors">Kelola via HP</a>
          <a href="#prayer-states" class="hover:text-[#D9B26A] transition-colors">Mode Sholat</a>
          <a href="#license" class="hover:text-[#D9B26A] transition-colors">Lisensi</a>
          <a href="/assalam-tv/tester" class="text-[#D9B26A] hover:underline font-semibold">Tester Gratis</a>
        </nav>

        <!-- Right Side: Lang Switcher & CTA -->
        <div class="hidden sm:flex items-center gap-4">
          <!-- Lang Switcher -->
          <div class="flex items-center bg-white/10 rounded-full p-1 border border-white/15 text-xs font-bold">
            <span class="px-3 py-1.5 rounded-full bg-[#D9B26A] text-[#0A1D31]">ID</span>
            <a href="/assalam-tv/en" class="px-3 py-1.5 rounded-full text-[#A7B4C6] hover:text-white transition">EN</a>
            <a href="/assalam-tv/ar" class="px-3 py-1.5 rounded-full text-[#A7B4C6] hover:text-white transition">AR</a>
          </div>

          <!-- Main CTA -->
          <a href="#download" class="gold-gradient-bg text-[#0A1D31] font-bold text-xs sm:text-sm px-5 py-2.5 rounded-full shadow-lg hover:brightness-105 transition transform hover:-translate-y-0.5">
            Unduh di Google Play
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-toggle-btn" class="lg:hidden text-[#F5F2EA] p-2 rounded-lg hover:bg-white/10 transition" aria-label="Toggle Navigation">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav Drawer -->
    <div id="mobile-menu-drawer" class="hidden lg:hidden bg-[#0E2A47] border-b border-[#D9B26A]/20 px-6 py-6 space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-white/10">
        <span class="text-xs uppercase tracking-wider text-[#D9B26A] font-bold">Pilihan Bahasa</span>
        <div class="flex items-center bg-white/10 rounded-full p-1 text-xs font-bold">
          <span class="px-3 py-1 rounded-full bg-[#D9B26A] text-[#0A1D31]">ID</span>
          <a href="/assalam-tv/en" class="px-3 py-1 rounded-full text-[#A7B4C6]">EN</a>
          <a href="/assalam-tv/ar" class="px-3 py-1 rounded-full text-[#A7B4C6]">AR</a>
        </div>
      </div>
      <a href="#themes" class="mobile-nav-link block text-sm font-medium text-[#B9C6D6] hover:text-[#D9B26A]">Tema &amp; Warna</a>
      <a href="#vertical" class="mobile-nav-link block text-sm font-medium text-[#B9C6D6] hover:text-[#D9B26A]">Tampilan Vertikal</a>
      <a href="#features" class="mobile-nav-link block text-sm font-medium text-[#B9C6D6] hover:text-[#D9B26A]">Kelola via HP</a>
      <a href="#prayer-states" class="mobile-nav-link block text-sm font-medium text-[#B9C6D6] hover:text-[#D9B26A]">Mode Sholat</a>
      <a href="#license" class="mobile-nav-link block text-sm font-medium text-[#B9C6D6] hover:text-[#D9B26A]">Lisensi</a>
      <a href="/assalam-tv/tester" class="mobile-nav-link block text-sm font-bold text-[#D9B26A]">Daftar Tester Gratis</a>
      <div class="pt-2">
        <a href="#download" class="mobile-nav-link block text-center gold-gradient-bg text-[#0A1D31] font-bold text-sm py-3 rounded-xl shadow">
          Unduh di Google Play
        </a>
      </div>
    </div>
  </header>

  <main class="overflow-hidden">
    <!-- ==================== 1. HERO SECTION ==================== -->
    <section class="relative pt-32 pb-24 lg:pt-40 lg:pb-36 bg-gradient-to-b from-[#061423] via-[#0A1D31] to-[#0E2A47] text-white overflow-hidden">
      <!-- Glows and Rings -->
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="ring-decor w-[550px] h-[550px] -top-20 -right-20"></div>
      <div class="ring-decor w-[750px] h-[750px] -top-44 -right-44"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Sub-label Top -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-[#D9B26A]/30 text-[#D9B26A] text-xs font-bold tracking-widest uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-[#D9B26A] animate-pulse"></span>
          ASSALAM TV · MOSQUE PRAYER DISPLAY · 100% OFFLINE
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          <!-- Left Column Copy -->
          <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
            <div class="text-[#D9B26A] font-extrabold text-xs sm:text-sm tracking-wider uppercase">
              APLIKASI JAM SHOLAT DIGITAL MASJID
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#F5F2EA] tracking-tight leading-[1.15]">
              Jadwal Sholat Digital Akurat &amp; <span class="gold-gradient-text">Theme Premium</span>
            </h1>

            <p class="text-base sm:text-lg text-[#B9C6D6] leading-relaxed max-w-xl mx-auto lg:mx-0 font-normal">
              Kelola jadwal sholat, pengumuman DKM, dan foto kajian langsung dari HP Admin lewat Wi-Fi lokal. Tanpa kuota internet harian, tanpa flashdisk, dan bebas biaya langganan bulanan.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
              <a href="#download" class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-[#0A1D31] border border-[#D9B26A]/40 text-[#F5F2EA] font-extrabold text-sm shadow-xl hover:border-[#D9B26A] hover:bg-[#0E2A47] transition group w-full sm:w-auto">
                <img src="/images/google-play-id.png" alt="Google Play" class="h-6 w-auto" />
                <span>Unduh TV Gratis</span>
              </a>

              <a href="#license" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full gold-gradient-bg text-[#0A1D31] font-extrabold text-sm shadow-xl hover:brightness-105 transition transform hover:-translate-y-0.5 w-full sm:w-auto">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M21 2l-2 2m-1.5 1.5L16 7m-1.5 1.5l-3 3-4-4-5.5 5.5a2.12 2.12 0 0 0 3 3L10.5 15l3 3 1.5-1.5M19 5l-2-2"/></svg>
                <span>Beli Lisensi Admin</span>
              </a>
            </div>

            <!-- Free Tester Callout link -->
            <p class="text-xs text-[#A7B4C6] pt-1">
              Ingin Lisensi Admin gratis? <a href="/assalam-tv/tester" class="text-[#D9B26A] font-bold underline hover:text-[#EBD3A0]">Daftar jadi penguji awal (closed tester) di sini &rarr;</a>
            </p>
          </div>

          <!-- Right Column Visual: Overlapping Mockups -->
          <div class="lg:col-span-6 relative flex justify-center items-center">
            <div class="relative w-full max-w-lg lg:max-w-none">
              <!-- Horizontal TV Frame -->
              <div class="relative rounded-2xl md:rounded-3xl overflow-hidden border-2 md:border-4 border-[#0E2A47] tv-frame-shadow bg-black aspect-video">
                <img
                  id="hero-main-tv"
                  src="/images/assalam-tv/id-h-obsidian.png"
                  alt="Tampilan TV Assalam TV Tema Obsidian"
                  class="w-full h-full object-cover transition-opacity duration-500"
                />
              </div>

              <!-- Overlapping Vertical Kiosk Frame -->
              <div class="absolute -bottom-6 -right-3 sm:-bottom-8 sm:-right-4 w-32 sm:w-44 md:w-52 aspect-[9/16] rounded-xl sm:rounded-2xl overflow-hidden border-2 sm:border-4 border-[#0A1D31] shadow-2xl bg-black">
                <img
                  src="/images/assalam-tv/id-v-nila.png"
                  alt="Tampilan Vertikal Standing Totem Assalam TV"
                  class="w-full h-full object-cover"
                />
              </div>

              <!-- Floating Trust Badge Chip -->
              <div class="absolute -top-4 -left-2 sm:-top-5 sm:-left-4 inline-flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-[#0E2440]/90 backdrop-blur-md border border-[#D9B26A]/50 shadow-xl text-xs font-bold text-[#F5F2EA]">
                <svg class="w-4 h-4 text-[#D9B26A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                <span>Lisensi Lifetime &bull; Tanpa Langganan</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 4 Core Feature Strip at the Bottom of Hero -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mt-16 pt-8 border-t border-white/10">
          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/[0.07] border border-white/10 backdrop-blur-sm">
            <div class="w-9 h-9 rounded-xl bg-[#D9B26A]/20 text-[#D9B26A] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 2l20 20"></path></svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-bold text-[#F5F2EA]">100% Offline</div>
              <div class="text-[11px] text-[#A7B4C6]">Bebas internet harian</div>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/[0.07] border border-white/10 backdrop-blur-sm">
            <div class="w-9 h-9 rounded-xl bg-[#D9B26A]/20 text-[#D9B26A] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-bold text-[#F5F2EA]">18 Tema Mewah</div>
              <div class="text-[11px] text-[#A7B4C6]">Horizontal &amp; Sidebar</div>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/[0.07] border border-white/10 backdrop-blur-sm">
            <div class="w-9 h-9 rounded-xl bg-[#D9B26A]/20 text-[#D9B26A] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-bold text-[#F5F2EA]">Tanpa ShareIt</div>
              <div class="text-[11px] text-[#A7B4C6]">Kirim dari galeri HP</div>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/[0.07] border border-white/10 backdrop-blur-sm">
            <div class="w-9 h-9 rounded-xl bg-[#D9B26A]/20 text-[#D9B26A] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" stroke-width="2"></rect><line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2"></line></svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-bold text-[#F5F2EA]">Siap Vertikal</div>
              <div class="text-[11px] text-[#A7B4C6]">Totem standing 9:16</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Wave Bottom Transition into Ivory (#F7F4EC) -->
      <div class="w-full text-[#F7F4EC] -mb-1 mt-12">
        <svg viewBox="0 0 1440 80" fill="currentColor" preserveAspectRatio="none" class="w-full h-12 md:h-20 block">
          <path d="M0,32L80,42.7C160,53,320,75,480,74.7C640,75,800,53,960,42.7C1120,32,1280,32,1360,32L1440,32L1440,80L1360,80C1280,80,1120,80,960,80C800,80,640,80,480,80C320,80,160,80,80,80L0,80Z"></path>
        </svg>
      </div>
    </section>

    <!-- ==================== 2. FITUR OPSI C: SCREENSHOT BESAR + GRID CHIP ==================== -->
    <section id="features" class="py-20 lg:py-28 bg-[#F7F4EC] text-[#10233A]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="w-12 h-1.5 bg-[#D9B26A] rounded-full mx-auto mb-4"></div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#10233A] tracking-tight leading-tight">
            Semua yang Dibutuhkan Pengurus DKM, dalam Satu Layar
          </h2>
          <p class="mt-4 text-base sm:text-lg text-[#5C6A7C] leading-relaxed">
            Delapan fitur inti yang membuat TV masjid Anda benar-benar mandiri — dikendalikan penuh dari HP, tanpa aplikasi tambahan.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <!-- Left: Big Screenshot Showcase -->
          <div class="lg:col-span-7 space-y-3">
            <div class="rounded-3xl overflow-hidden border-2 border-[#E7E0D2] shadow-2xl bg-black aspect-video">
              <img
                src="/images/assalam-tv/id-sidebar-lazuardi.png"
                alt="Tampilan Sidebar Kiri Tema Lazuardi Assalam TV"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="text-xs sm:text-sm text-center text-[#5C6A7C] italic">
              Tampilan sidebar kiri — tema Lazuardi (biru safir damai)
            </p>
          </div>

          <!-- Right: Grid of 8 Feature Chips -->
          <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-3.5">
            <!-- Chip 1 -->
            <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-[#E7E0D2] shadow-sm hover:shadow-md transition">
              <div class="w-10 h-10 rounded-xl bg-[#D9B26A]/15 text-[#9A7228] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"></rect><line x1="16" y1="2" x2="16" y2="6" stroke-width="2"></line><line x1="8" y1="2" x2="8" y2="6" stroke-width="2"></line><line x1="3" y1="10" x2="21" y2="10" stroke-width="2"></line></svg>
              </div>
              <span class="text-sm font-bold text-[#10233A]">Kalender Hijriyah Astronomis</span>
            </div>

            <!-- Chip 2 -->
            <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-[#E7E0D2] shadow-sm hover:shadow-md transition">
              <div class="w-10 h-10 rounded-xl bg-[#D9B26A]/15 text-[#9A7228] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
              </div>
              <span class="text-sm font-bold text-[#10233A]">Pop up Event &amp; Peringatan Hari Besar</span>
            </div>

            <!-- Chip 3 -->
            <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-[#E7E0D2] shadow-sm hover:shadow-md transition">
              <div class="w-10 h-10 rounded-xl bg-[#D9B26A]/15 text-[#9A7228] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"></circle><polyline points="12 6 12 12 16 14" stroke-width="2"></polyline></svg>
              </div>
              <span class="text-sm font-bold text-[#10233A]">Jam Waktu Sholat Presisi &amp; Ihtiyati</span>
            </div>

            <!-- Chip 4 -->
            <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-[#E7E0D2] shadow-sm hover:shadow-md transition">
              <div class="w-10 h-10 rounded-xl bg-[#D9B26A]/15 text-[#9A7228] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              </div>
              <span class="text-sm font-bold text-[#10233A]">Running Text Warta &amp; Laporan Kas DKM</span>
            </div>

            <!-- Chip 5 -->
            <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-[#E7E0D2] shadow-sm hover:shadow-md transition">
              <div class="w-10 h-10 rounded-xl bg-[#D9B26A]/15 text-[#9A7228] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"></circle><polyline points="12 6 12 12 14 10" stroke-width="2"></polyline></svg>
